// ============================================================
// μέτρηση/βάση.zy — what one generation costs, and where it goes.
//
// Three variants of the same computation, so the number that comes
// out separates three costs that a single benchmark would blend:
//
//   A  κόσμος::βήμα        a call per cell, a new grid per step
//   B  inline neighbours   no call per cell, a new grid per step
//   C  count only          no call, no grid — just the arithmetic
//
// A - B is what a function call per cell costs.
// B - C is what building the next grid costs.
//
// This is deliberately not in zyquality/bench/: those are
// microbenchmarks, and a microbenchmark does not touch aggregate
// copying, which is the cost that dominates here and the one HLZ-012
// and HLZ-014 were about.
// ============================================================

<# ../πυρήνας/κόσμος => κ
<# std/time => χ

// Same offsets as κόσμος, repeated here on purpose: the point of
// variant B is that nothing crosses a call boundary.
ΔΓ := [-1, -1, -1,  0,  0,  1,  1,  1]
ΔΣ := [-1,  0,  1, -1,  1, -1,  0,  1]

στήσε(πλευρά, σπόρος) {
    (π, _κ) = κ::τυχαίος(πλευρά, πλευρά, 28, σπόρος)
    <~ π
}

// B — the neighbour count written where it is used.
βήμα_εντός(π, γέννηση, επιβίωση) {
    γραμμές = π$#
    στήλες = π[1]$#
    επόμενο = []
    γ = 0
    @ σειρά:π {
        γ += 1
        νέα = []
        σ = 0
        @ κύτταρο:σειρά {
            σ += 1
            ν = 0
            θ = 0
            @ δγ:ΔΓ {
                θ += 1
                ργ = ((γ + δγ - 1 + γραμμές) % γραμμές) + 1
                ρσ = ((σ + ΔΣ[θ] - 1 + στήλες) % στήλες) + 1
                ν += π[ργ>ρσ]
            }
            ? κύτταρο == 1 { νέα$+ επιβίωση[ν + 1] } _ { νέα$+ γέννηση[ν + 1] }
        }
        επόμενο$+ νέα
    }
    <~ επόμενο
}

// C — every neighbour visited, every rule applied, nothing built.
μέτρα_μόνο(π, γέννηση, επιβίωση) {
    γραμμές = π$#
    στήλες = π[1]$#
    άθροισμα = 0
    γ = 0
    @ σειρά:π {
        γ += 1
        σ = 0
        @ κύτταρο:σειρά {
            σ += 1
            ν = 0
            θ = 0
            @ δγ:ΔΓ {
                θ += 1
                ργ = ((γ + δγ - 1 + γραμμές) % γραμμές) + 1
                ρσ = ((σ + ΔΣ[θ] - 1 + στήλες) % στήλες) + 1
                ν += π[ργ>ρσ]
            }
            ? κύτταρο == 1 { άθροισμα += επιβίωση[ν + 1] } _ { άθροισμα += γέννηση[ν + 1] }
        }
    }
    <~ άθροισμα
}

χρόνος_Α(π, γενιές, γέννηση, επιβίωση) {
    α = χ::now()
    @ γενιές { π = κ::βήμα(π, γέννηση, επιβίωση, #1) }
    <~ (χ::now() - α, κ::πληθυσμός(π))
}

χρόνος_Β(π, γενιές, γέννηση, επιβίωση) {
    α = χ::now()
    @ γενιές { π = βήμα_εντός(π, γέννηση, επιβίωση) }
    <~ (χ::now() - α, κ::πληθυσμός(π))
}

χρόνος_Γ(π, γενιές, γέννηση, επιβίωση) {
    α = χ::now()
    τελικό = 0
    @ γενιές { τελικό = μέτρα_μόνο(π, γέννηση, επιβίωση) }
    <~ (χ::now() - α, τελικό)
}

>< args
πλευρά = 48
γενιές = 10
? args$# >= 1 {
    ν = 0
    @ χαρ:args[1] { ν = ν * 10 + (##!χαρ - ##!'0') }
    ? ν > 0 { πλευρά = ν }
}
? args$# >= 2 {
    ν = 0
    @ χαρ:args[2] { ν = ν * 10 + (##!χαρ - ##!'0') }
    ? ν > 0 { γενιές = ν }
}

γ = []
ε = []
(_μ, γ, ε) = κ::κανόνας("B3/S23")

αρχικό = στήσε(πλευρά, 20260904)
κύτταρα = πλευρά * πλευρά * γενιές

>> "side " πλευρά "  gens " γενιές "  cell-steps " κύτταρα ¶

(μς_Α, πληθ_Α) = χρόνος_Α(αρχικό, γενιές, γ, ε)
(μς_Β, πληθ_Β) = χρόνος_Β(αρχικό, γενιές, γ, ε)
(μς_Γ, _αθρ)   = χρόνος_Γ(αρχικό, γενιές, γ, ε)

>> "A call+build  " μς_Α "ms" ¶
>> "B build       " μς_Β "ms" ¶
>> "C count       " μς_Γ "ms" ¶
>> "same answer   " (πληθ_Α == πληθ_Β) ¶
