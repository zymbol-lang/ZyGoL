// ============================================================
// μέτρηση/όλα.zy — ο δρομέας των μετρήσεων, γραμμένος σε Zymbol.
//
//   zymbol run μέτρηση/όλα.zy              32 48 64, 10 γενιές
//   zymbol run μέτρηση/όλα.zy 64 100       άλλα μεγέθη
//   zymbol run μέτρηση/όλα.zy 64 -g 20     άλλες γενιές
//   zymbol run μέτρηση/όλα.zy 48 --χωρίς-js
//
// Εδώ ΧΡΕΙΑΖΕΤΑΙ να ξεκινήσουν άλλες διεργασίες, γιατί το ζητούμενο
// είναι να συγκριθούν ΤΡΕΙΣ ΜΗΧΑΝΕΣ και ένα πρόγραμμα τρέχει σε μία.
// Το `<\ … \>` φτάνει, επειδή το μόνο που θέλουμε πίσω είναι η έξοδος
// — τον κωδικό εξόδου δεν τον δίνει (HALLAZGOS.md, GAP-GOL-011), και
// γι' αυτό ένα τρέξιμο που απέτυχε φαίνεται εδώ ως «—» και όχι ως
// σφάλμα. Είναι όσο κοντά στο σωστό φτάνει κανείς σήμερα.
//
// Ο δρομέας των ΔΟΚΙΜΩΝ δεν χρειάζεται τίποτα από αυτά: εισάγει τις
// σουίτες ως modules (δοκιμές/όλα.zy). Το ότι εδώ χρειάζεται shell
// είναι ιδιότητα του ερωτήματος, όχι της γλώσσας.
// ============================================================

<# std/io => εισ
<# ../πρότυπο/τερματικό => τ

ΕΔΩ := "μέτρηση"
ΜΗΧΑΝΕΣ := ["zytw", "zyvm", "zyjs"]
ΠΡΟΕΠΙΛΟΓΗ := [32, 48, 64]

αριθμός(κείμενο) {
    ? κείμενο$# < 1 { <~ -1 }
    ν = 0
    @ χαρ:κείμενο {
        ψ = ##!χαρ - ##!'0'
        ? ψ < 0 || ψ > 9 { <~ -1 }
        ν = ν * 10 + ψ
    }
    <~ ν
}

// Η τιμή μετά από «A ... 123ms» — το τελευταίο κομμάτι της γραμμής
// που αρχίζει με το γράμμα, χωρίς το "ms".
τιμή_από(έξοδος, γράμμα) {
    @ γραμμή:(έξοδος $/ '\n') {
        ? γραμμή$# < 1 { @> }
        // γραμμή[1] είναι Char· γραμμή[1..1] θα ήταν ΠΙΝΑΚΑΣ και
        // γραμμή$[1..1] String. Τρεις μορφές, τρεις τύποι.
        ? γραμμή[1] <> γράμμα { @> }
        @ κ:(γραμμή $/ ' ') {
            ? κ$# > 2 && (κ$[-2..-1]) == "ms" { <~ αριθμός(κ$[1..-3]) }
        }
    }
    <~ -1
}

// Το run_one.mjs δεν περνά ορίσματα στο πρόγραμμα (GAP-GOL-006), κι
// η μηχανή του φυλλομετρητή δεν έχει `><` από εκεί. Οπότε γράφουμε
// ένα αντίγραφο με τα μεγέθη μέσα — με std/io, όχι με sed.
ετοίμασε_για_js(πλευρά, γενιές) {
    πηγή = εισ::read(ΕΔΩ "/βάση.zy")
    ? πηγή$! { <~ "" }
    // Οι αντικαταστάσεις δένονται πρώτα σε όνομα: το $~~[α:β] δεν
    // δέχεται παράθεση μέσα στα άγκιστρα.
    νέα_πλευρά = "πλευρά = " πλευρά
    νέες_γενιές = "γενιές = " γενιές
    προσαρμοσμένο = πηγή$~~["πλευρά = 48":νέα_πλευρά]
    προσαρμοσμένο = προσαρμοσμένο$~~["γενιές = 10":νέες_γενιές]
    διαδρομή = ΕΔΩ "/.js_" πλευρά "_" γενιές ".zy"
    γρ = εισ::write(διαδρομή, προσαρμοσμένο)
    ? γρ$! { <~ "" }
    <~ διαδρομή
}

τρέξε_μηχανή(μηχανή, πλευρά, γενιές) {
    ?? μηχανή {
        "zytw" => { <~ <\ "zymbol run " ΕΔΩ "/βάση.zy " πλευρά " " γενιές " 2>/dev/null" \> }
        "zyvm" => { <~ <\ "zymbol run --vm " ΕΔΩ "/βάση.zy " πλευρά " " γενιές " 2>/dev/null" \> }
        _ => {
            διαδρομή = ετοίμασε_για_js(πλευρά, γενιές)
            ? διαδρομή == "" { <~ "" }
            έξοδος = <\ "node ../web/tests/run_one.mjs " διαδρομή " </dev/null 2>/dev/null" \>
            εισ::delete(διαδρομή)
            <~ έξοδος
        }
    }
}

>< args

πλευρές = []
γενιές = 10
χωρίς_js = #0
περίμενε_γενιές = #0

@ όρισμα:args {
    ? περίμενε_γενιές { γενιές = αριθμός(όρισμα)
                        περίμενε_γενιές = #0
                        @> }
    ? όρισμα == "-g" || όρισμα == "--gens" { περίμενε_γενιές = #1
                                             @> }
    ? όρισμα == "--sin-js" || όρισμα == "--no-js" || όρισμα == "--χωρίς-js" { χωρίς_js = #1
                                                      @> }
    ν = αριθμός(όρισμα)
    ? ν > 0 { πλευρές$+ ν } _ { >> "δεν είναι μέγεθος: " όρισμα ¶
                                <~ 2 }
}
? πλευρές$# == 0 { @ ν:ΠΡΟΕΠΙΛΟΓΗ { πλευρές$+ ν } }
? γενιές <= 0 { γενιές = 10 }

>> τ::αριστερή_στοίχιση("πλευρά", 8) τ::αριστερή_στοίχιση("μηχανή", 8)
   τ::δεξιά_στοίχιση("A", 9) τ::δεξιά_στοίχιση("B", 9) τ::δεξιά_στοίχιση("C", 9)
   τ::δεξιά_στοίχιση("ns/κύτταρο", 12) τ::δεξιά_στοίχιση("A/B", 8) ¶
>> ("─" $* 62) ¶

@ πλευρά:πλευρές {
    βήματα = πλευρά * πλευρά * γενιές
    @ μηχανή:ΜΗΧΑΝΕΣ {
        ? χωρίς_js && μηχανή == "zyjs" { @> }
        έξοδος = τρέξε_μηχανή(μηχανή, πλευρά, γενιές)
        α = τιμή_από(έξοδος, 'A')
        β = τιμή_από(έξοδος, 'B')
        γ = τιμή_από(έξοδος, 'C')
        ? α < 0 {
            // Χωρίς κωδικό εξόδου δεν ξέρουμε αν έσπασε ή απλώς δεν
            // βρέθηκε ο μεταφραστής. Το λέμε έτσι όπως είναι.
            >> τ::αριστερή_στοίχιση("" πλευρά, 8) τ::αριστερή_στοίχιση(μηχανή, 8) τ::δεξιά_στοίχιση("—", 9) ¶
            @>
        }
        ανά = (α * 1000000) / βήματα
        αναλογία = 0
        ? β > 0 { αναλογία = (α * 100) / β }
        // Το κλάσμα δένεται πρώτα σε όνομα: μέσα σε ορίσματα κλήσης
        // μια παρένθεση δεν συνεχίζει την παράθεση.
        ακέραιο = αναλογία / 100
        δεκαδικό = αναλογία % 100
        κλάσμα = ακέραιο "." δεκαδικό
        ? δεκαδικό < 10 { κλάσμα = ακέραιο ".0" δεκαδικό }
        >> τ::αριστερή_στοίχιση("" πλευρά, 8) τ::αριστερή_στοίχιση(μηχανή, 8)
           τ::δεξιά_στοίχιση("" α, 9) τ::δεξιά_στοίχιση("" β, 9) τ::δεξιά_στοίχιση("" γ, 9)
           τ::δεξιά_στοίχιση("" ανά, 12)
           τ::δεξιά_στοίχιση(κλάσμα, 8) ¶
    }
}
