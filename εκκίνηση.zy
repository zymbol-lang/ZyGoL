// ============================================================
// εκκίνηση.zy — η γραμμή εντολών και το στήσιμο του κόσμου.
//
// Τα σημεία εισόδου (ζωή.zy, vida.zy, life.zy, जीवन.zy) διαλέγουν
// γλώσσα και τίποτα άλλο· όλη η δουλειά είναι εδώ, ώστε ένα σημείο
// εισόδου να μην είναι ταυτόχρονα και το πρόγραμμα (USERAPPI18N.md
// §8, και το μάθημα που έβγαλε η Serpiente όταν χρειάστηκε να
// χωρίσει το juego.zy από το serpiente.zy).
//
// Οι σημαίες είναι ASCII και αγγλικές επίτηδες, ενώ όλα τα ονόματα
// μέσα στο πρόγραμμα είναι ελληνικά. Μια γραμμή εντολών είναι η μία
// επιφάνεια που γράφεται για ΜΗΧΑΝΗ να τη διαβάσει πίσω: ένα shell,
// ένα Makefile, μια δουλειά CI. Είναι ο ίδιος λόγος για τον οποίο το
// std/time::format δεν ακολουθεί ποτέ τη γραφή των ψηφίων.
// ============================================================

# εκκίνηση {

    <# ./πυρήνας/κόσμος => κ
    <# ./πυρήνας/σχήματα => σ
    <# ./εμφάνιση/όψη => ό
    <# ./γλώσσα/διανομέας => γ
    <# ./πρότυπο/τερματικό => τ
    <# ./παιχνίδι => παι
    <# std/time => χρ

    #> { ξεκίνα }

    ΠΥΚΝΟΤΗΤΑ := 28

    // Μη αρνητικός ακέραιος, ή -1 αν το κείμενο δεν είναι αριθμός.
    // Διαβάζει ΜΟΝΟ ASCII ψηφία: η τιμή έρχεται από γραμμή εντολών,
    // κι εκεί τα ψηφία είναι πάντα ASCII ό,τι γλώσσα κι αν τρέχει.
    _αριθμός(κείμενο) {
        ? κείμενο$# < 1 { <~ -1 }
        ν = 0
        @ χαρ:κείμενο {
            ψ = ##!χαρ - ##!'0'
            ? ψ < 0 || ψ > 9 { <~ -1 }
            ν = ν * 10 + ψ
        }
        <~ ν
    }

    _γνωστή_γλώσσα(κωδικός) {
        @ κ2:γ::γλώσσες() { ? κ2 == κωδικός { <~ #1 } }
        <~ #0
    }

    _γράψε_κόσμο(π) {
        @ σειρά:π {
            γραμμή = ""
            @ κύτταρο:σειρά {
                ? κύτταρο == 1 { γραμμή = γραμμή "#" } _ { γραμμή = γραμμή "." }
            }
            >> γραμμή ¶
        }
    }

    _βοήθεια() {
        >> γ::κείμενο("χρήση.τίτλος") ¶
        >> ¶
        >> "  -r, --rows N       " γ::κείμενο("χρήση.γραμμές") ¶
        >> "  -c, --cols N       " γ::κείμενο("χρήση.στήλες") ¶
        >> "  -p, --pattern NAME " γ::κείμενο("χρήση.σχήμα") ¶
        >> "  -R, --rule RULE    " γ::κείμενο("χρήση.κανόνας") ¶
        >> "  -t, --theme NAME   " γ::κείμενο("χρήση.θέμα") ¶
        >> "  -d, --delay MS     " γ::κείμενο("χρήση.ρυθμός") ¶
        >> "  -s, --seed N       " γ::κείμενο("χρήση.σπόρος") ¶
        >> "  -x, --random       " γ::κείμενο("χρήση.τυχαίο") ¶
        >> "  -e, --edges        " γ::κείμενο("χρήση.φραγμένο") ¶
        >> "  -n, --turns N      " γ::κείμενο("χρήση.γύροι") ¶
        >> "      --run          " γ::κείμενο("χρήση.τρέξε") ¶
        >> "  -b, --batch        " γ::κείμενο("χρήση.γενιές") ¶
        >> "      --every K      " γ::κείμενο("χρήση.κάθε") ¶
        >> "      --print        " γ::κείμενο("χρήση.τύπωσε") ¶
        >> "  -L, --lang CODE    " γ::κείμενο("χρήση.γλώσσα") ¶
        >> "  -l, --list         " γ::κείμενο("χρήση.κατάλογος") ¶
        >> "  -h, --help         " γ::κείμενο("χρήση.βοήθεια") ¶
        >> ¶
        >> "  " γ::κείμενο("χρήση.σχήματα") ": " ¶
        @ όνομα:σ::ονόματα() {
            (μ, κελιά) = σ::πάρε(όνομα)
            ? μ == "" {
                (μγ, μσ) = σ::μέγεθος(κελιά)
                >> "    " τ::αριστερή_στοίχιση(όνομα, 16) τ::αριστερή_στοίχιση(γ::κείμενο("σχήμα." όνομα), 22)
                   " " τ::αριστερή_στοίχιση(γ::κείμενο("κατηγορία." σ::κατηγορία(όνομα)), 16)
                   " " μγ "×" μσ ¶
            }
        }
    }

    _κατάλογος() {
        >> γ::κείμενο("χρήση.σχήματα") ": " ¶
        @ όνομα:σ::ονόματα() {
            (μ, κελιά) = σ::πάρε(όνομα)
            ? μ == "" {
                >> "  " τ::αριστερή_στοίχιση(όνομα, 16) τ::αριστερή_στοίχιση(γ::κείμενο("σχήμα." όνομα), 22)
                   " " γ::κείμενο("κατηγορία." σ::κατηγορία(όνομα)) " (" κελιά$# ")" ¶
            }
        }
        >> ¶
        @ όνομα:ό::ονόματα_θεμάτων() {
            (μ, θ) = ό::θέμα(όνομα)
            ? μ == "" { >> "  " τ::αριστερή_στοίχιση(όνομα, 16) τ::αριστερή_στοίχιση(γ::κείμενο("θέμα." όνομα), 22) " " θ.ζ θ.ν ¶ }
        }
        >> ¶
        @ κωδικός:γ::γλώσσες() {
            >> "  " τ::αριστερή_στοίχιση(κωδικός, 16) γ::όνομα_γλώσσας(κωδικός) ¶
        }
    }

    ξεκίνα(αρχική_γλώσσα, args) {
        γ::όρισε(αρχική_γλώσσα)

        γραμμές = 0
        στήλες = 0
        σχήμα = ""
        όνομα_κανόνα = "B3/S23"
        θέμα = "emoji"
        καθυστέρηση = 120
        σπόρος = 12345
        γύροι = 0
        κάθε = 0
        τυχαία = #0
        τοροειδές = #1
        παρτίδα = #0
        τύπωσε = #0
        τρέχει = #0
        σφάλμα = ""
        περίμενε = ""
        βοήθεια = #0
        κατάλογος = #0

        @ όρισμα:args {
            ? σφάλμα <> "" { @! }

            ? περίμενε <> "" {
                ? περίμενε == "rows"    { γραμμές = _αριθμός(όρισμα) }
                ? περίμενε == "cols"    { στήλες = _αριθμός(όρισμα) }
                ? περίμενε == "pattern" { σχήμα = όρισμα }
                ? περίμενε == "rule"    { όνομα_κανόνα = όρισμα }
                ? περίμενε == "theme"   { θέμα = όρισμα }
                ? περίμενε == "delay"   { καθυστέρηση = _αριθμός(όρισμα) }
                ? περίμενε == "seed"    { σπόρος = _αριθμός(όρισμα) }
                ? περίμενε == "turns"   { γύροι = _αριθμός(όρισμα) }
                ? περίμενε == "every"   { κάθε = _αριθμός(όρισμα) }
                ? περίμενε == "lang"    {
                    ? _γνωστή_γλώσσα(όρισμα) { γ::όρισε(όρισμα) }
                    _ { σφάλμα = "σφάλμα.άγνωστη_γλώσσα" }
                }
                περίμενε = ""
                @>
            }

            ? όρισμα == "-h" || όρισμα == "--help"    { βοήθεια = #1
                                                        @> }
            ? όρισμα == "-l" || όρισμα == "--list"    { κατάλογος = #1
                                                        @> }
            ? όρισμα == "-x" || όρισμα == "--random"  { τυχαία = #1
                                                        @> }
            ? όρισμα == "-e" || όρισμα == "--edges"   { τοροειδές = #0
                                                        @> }
            ? όρισμα == "-b" || όρισμα == "--batch"   { παρτίδα = #1
                                                        @> }
            ? όρισμα == "--run"                       { τρέχει = #1
                                                        @> }
            ? όρισμα == "--print"                     { τύπωσε = #1
                                                        @> }
            ? όρισμα == "-r" || όρισμα == "--rows"    { περίμενε = "rows"
                                                        @> }
            ? όρισμα == "-c" || όρισμα == "--cols"    { περίμενε = "cols"
                                                        @> }
            ? όρισμα == "-p" || όρισμα == "--pattern" { περίμενε = "pattern"
                                                        @> }
            ? όρισμα == "-R" || όρισμα == "--rule"    { περίμενε = "rule"
                                                        @> }
            ? όρισμα == "-t" || όρισμα == "--theme"   { περίμενε = "theme"
                                                        @> }
            ? όρισμα == "-d" || όρισμα == "--delay"   { περίμενε = "delay"
                                                        @> }
            ? όρισμα == "-s" || όρισμα == "--seed"    { περίμενε = "seed"
                                                        @> }
            ? όρισμα == "-n" || όρισμα == "--turns"   { περίμενε = "turns"
                                                        @> }
            ? όρισμα == "--every"                     { περίμενε = "every"
                                                        @> }
            ? όρισμα == "-L" || όρισμα == "--lang"    { περίμενε = "lang"
                                                        @> }
            σφάλμα = "σφάλμα.άγνωστη_επιλογή"
        }

        ? σφάλμα == "" && περίμενε <> "" { σφάλμα = "σφάλμα.λείπει_τιμή" }

        ? σφάλμα == "" && βοήθεια { _βοήθεια()
                                    <~ 0 }
        ? σφάλμα == "" && κατάλογος { _κατάλογος()
                                      <~ 0 }

        γέννηση = []
        επιβίωση = []
        ? σφάλμα == "" {
            (κλειδί_κανόνα, γέννηση, επιβίωση) = κ::κανόνας(όνομα_κανόνα)
            ? κλειδί_κανόνα <> "" { σφάλμα = κλειδί_κανόνα }
        }
        ? σφάλμα == "" {
            (κλειδί_θέματος, _θ) = ό::θέμα(θέμα)
            ? κλειδί_θέματος <> "" { σφάλμα = κλειδί_θέματος }
        }
        ? σφάλμα == "" && σχήμα <> "" {
            (κλειδί_σχήματος, _κελιά) = σ::πάρε(σχήμα)
            ? κλειδί_σχήματος <> "" { σφάλμα = κλειδί_σχήματος }
        }
        ? σφάλμα == "" && (γραμμές < 0 || στήλες < 0 || καθυστέρηση < 0 || σπόρος < 0 || κάθε < 0 || γύροι < 0) {
            σφάλμα = "σφάλμα.αριθμός"
        }

        ? σφάλμα <> "" {
            >> "error: " γ::κείμενο(σφάλμα) ¶
            <~ 2
        }

        // ── Ο κόσμος δεν ξεπερνά ποτέ την οθόνη ─────────────
        //
        // Ό,τι κι αν ζητηθεί, ο κόσμος κόβεται σε αυτό που χωρά. Ένα
        // πλέγμα πιο φαρδύ από την οθόνη θα ζωγραφιζόταν μισό, και
        // τα κύτταρα που δεν φαίνονται εξακολουθούν να μετρούν
        // γείτονες: αυτό που θα έβλεπε ο παίκτης δεν θα ήταν η Ζωή.
        // Σε παρτίδα χωρίς οθόνη το >>? απαντά (24, 80) αντί να
        // αποτύχει, και γι' αυτό η προεπιλογή είναι επαναλήψιμη.
        (ύψος, πλάτος) = >>?
        (χωρ_γ, χωρ_σ) = ό::χωράει(ύψος, πλάτος)
        ? χωρ_γ == 0 || χωρ_σ == 0 {
            >> "error: " γ::κείμενο("σφάλμα.μικρή_οθόνη") ¶
            <~ 2
        }
        περιορίστηκε = #0
        ? γραμμές == 0 { γραμμές = χωρ_γ }
        ? στήλες == 0 { στήλες = χωρ_σ }
        ? γραμμές > χωρ_γ { γραμμές = χωρ_γ
                            περιορίστηκε = #1 }
        ? στήλες > χωρ_σ { στήλες = χωρ_σ
                           περιορίστηκε = #1 }

        κόσμος = κ::νέος(γραμμές, στήλες)
        τρέχων_σπόρος = σπόρος
        ? τυχαία {
            (κόσμος, τρέχων_σπόρος) = κ::τυχαίος(γραμμές, στήλες, ΠΥΚΝΟΤΗΤΑ, σπόρος)
            σχήμα = "τυχαίο"
        }
        ? σχήμα <> "" && σχήμα <> "τυχαίο" {
            (_μσ, κελιά) = σ::πάρε(σχήμα)
            (υψ_σ, πλ_σ) = σ::μέγεθος(κελιά)
            κόσμος = σ::τοποθέτησε(κόσμος, κελιά, (γραμμές - υψ_σ) / 2 + 1, (στήλες - πλ_σ) / 2 + 1)
        }

        // ── Παρτίδα: χωρίς οθόνη, μία γραμμή ανά αναφορά ────
        ? παρτίδα {
            // Το αναγνωριστικό ΚΑΙ το όνομα: το πρώτο το ξαναδίνεις
            // στο -p, το δεύτερο το διαβάζεις.
            περιγραφή = σχήμα
            ? σχήμα == "τυχαίο" { περιγραφή = "random (" γ::κείμενο("πλήκτρο.τυχαίο") ", " σπόρος ")" }
            _? σχήμα <> "" { περιγραφή = σχήμα " (" γ::κείμενο("σχήμα." σχήμα) ")" }
            _ { περιγραφή = γ::κείμενο("κατάσταση.τίποτα") }

            >> γ::φράση_κόσμου(γραμμές, στήλες, τοροειδές) "  " όνομα_κανόνα "  " περιγραφή ¶
            ? περιορίστηκε { >> γ::κείμενο("χρήση.περιορίστηκε") ¶ }

            // γενιά, όχι "0": ο τρόπος γραφής των ψηφίων πιάνει την
            // ΕΚΤΥΠΩΣΗ ΑΡΙΘΜΟΥ, όχι τα γράμματα ενός literal, οπότε
            // ένα γραμμένο μηδέν μένει ASCII σε γλώσσα με δικά της
            // ψηφία. HALLAZGOS.md, IDEA-GOL-008.
            γενιά = 0
            >> γ::κείμενο("κατάσταση.γενιά") " " γενιά "  " γ::φράση_πληθυσμού(κ::πληθυσμός(κόσμος)) ¶

            αρχή = χρ::now()
            ιστορικό = []
            αιτία = ""
            περίοδος = 0
            @ {
                ? γύροι > 0 && γενιά >= γύροι { αιτία = "όριο"
                                                @! }
                ? γύροι == 0 && γενιά >= 1000 { αιτία = "όριο"
                                                @! }
                ιστορικό = κ::θύμησε(ιστορικό, κόσμος)
                κόσμος = κ::βήμα(κόσμος, γέννηση, επιβίωση, τοροειδές)
                γενιά += 1
                (αιτία, περίοδος) = κ::διάγνωση(κόσμος, ιστορικό)
                ? κάθε > 0 && γενιά % κάθε == 0 {
                    >> γ::κείμενο("κατάσταση.γενιά") " " γενιά "  " γ::φράση_πληθυσμού(κ::πληθυσμός(κόσμος)) ¶
                }
                ? αιτία <> "" { @! }
            }
            τέλος = χρ::now()

            ? κάθε == 0 || γενιά % κάθε <> 0 {
                >> γ::κείμενο("κατάσταση.γενιά") " " γενιά "  " γ::φράση_πληθυσμού(κ::πληθυσμός(κόσμος)) ¶
            }
            ? τύπωσε { _γράψε_κόσμο(κόσμος) }
            >> γ::φράση_τέλους(αιτία, γενιά, περίοδος) ¶
            // Η διάρκεια είναι για μηχανή, οπότε πάει έξω από τη
            // μετάφραση και μένει σε ASCII μονάδα.
            >> "elapsed " (τέλος - αρχή) "ms" ¶
            <~ 0
        }

        // ── Διαδραστικά ─────────────────────────────────────
        (αιτία, γενιά, περίοδος) = παι::τρέξε(κόσμος, θέμα, γέννηση, επιβίωση,
                                              όνομα_κανόνα, τοροειδές, καθυστέρηση,
                                              τρέχων_σπόρος, τρέχει, σχήμα, γύροι)
        >> γ::φράση_τέλους(αιτία, γενιά, περίοδος) ¶
        <~ 0
    }
}
