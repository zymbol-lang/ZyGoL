// ============================================================
// εμφάνιση/πλαίσιο.zy — πλαίσια που χωρούν κάθε γλώσσα.
//
// Μετράς το περιεχόμενο, ύστερα χτίζεις το πλαίσιο γύρω του. Ποτέ
// το αντίστροφο: αν το γέμισμα ζει μέσα στην ίδια συμβολοσειρά με το
// κείμενο, τότε η μετάφραση ξεκουρδίζει το πλαίσιο, και είτε
// ξαναγράφεις κάθε γραμμή για κάθε γλώσσα είτε κόβεις τη μετάφραση
// ώσπου να χωρέσει (USERAPPI18N.md §6).
//
// Μια γραμμή είναι πλειάδα (είδος, κείμενο) κι όχι συμβολοσειρά με
// σημάδι μπροστά: το «κεντράρισε αυτήν» είναι ιδιότητα της γραμμής,
// και μια πλειάδα το λέει χωρίς να χρειάζεται χαρακτήρας που κανείς
// δεν θα γράψει ποτέ.
//
// Τα πλάτη περνούν όλα από το std/term::width, μέσω του ελληνικού
// στρώματος: ένα ιδεόγραμμα, μια συλλαβή hangul και τα περισσότερα
// εικονίδια πιάνουν ΔΥΟ στήλες, και το $# λέει ένα.
// ============================================================

# .εμφάνιση_πλαίσιο {

    <# ../πρότυπο/τερματικό => τ

    #> { χτίσε, πλάτος_από, κανονική, κεντρική, χώρισμα, ΚΑΝΟΝΙΚΗ, ΚΕΝΤΡΙΚΗ, ΧΩΡΙΣΜΑ }

    ΚΑΝΟΝΙΚΗ := 0
    ΚΕΝΤΡΙΚΗ := 1
    ΧΩΡΙΣΜΑ  := 2

    κανονική(κείμενο) { <~ (ΚΑΝΟΝΙΚΗ, κείμενο) }
    κεντρική(κείμενο) { <~ (ΚΕΝΤΡΙΚΗ, κείμενο) }
    χώρισμα()         { <~ (ΧΩΡΙΣΜΑ, "") }

    // Το πιο φαρδύ, σε στήλες τερματικού.
    πλάτος_από(γραμμές) {
        μ = 0
        @ (είδος, κείμενο):γραμμές {
            ? είδος <> ΧΩΡΙΣΜΑ {
                π = τ::πλάτος(κείμενο)
                ? π > μ { μ = π }
            }
        }
        <~ μ
    }

    // Επιστρέφει γραμμές που έχουν ΟΛΕΣ ακριβώς το ίδιο πλήθος
    // στηλών, σε όποια γλώσσα κι αν είναι το περιεχόμενο. Το
    // κεντράρισμα γίνεται εδώ, όχι πριν: το πλάτος δεν είναι γνωστό
    // ώσπου να μετρηθεί κάθε γραμμή, κι ένας τίτλος κεντραρισμένος σε
    // μαντεμένο πλάτος ξεκεντράρεται μόλις κάποια άλλη γραμμή
    // μακρύνει — που είναι ακριβώς ό,τι κάνει μια μετάφραση.
    χτίσε(γραμμές, γέμισμα) {
        π = πλάτος_από(γραμμές)
        άκρη = "─" $* (π + γέμισμα * 2)
        έξω = ["╭" άκρη "╮"]
        κενό = " " $* γέμισμα
        @ (είδος, κείμενο):γραμμές {
            ? είδος == ΧΩΡΙΣΜΑ {
                έξω$+ ("├" άκρη "┤")
                @>
            }
            ? είδος == ΚΕΝΤΡΙΚΗ {
                έξω$+ ("│" κενό τ::κέντρο(κείμενο, π) κενό "│")
                @>
            }
            έξω$+ ("│" κενό τ::αριστερή_στοίχιση(κείμενο, π) κενό "│")
        }
        έξω$+ ("╰" άκρη "╯")
        <~ έξω
    }
}
