// ============================================================
// εμφάνιση/όψη.zy — θέματα, το πλέγμα, η γραμμή κατάστασης, τα μενού.
//
// Κάθε κύτταρο πιάνει ΔΥΟ στήλες τερματικού, σε κάθε θέμα. Δεν είναι
// στολίδι: ένα εικονίδιο πιάνει δύο στήλες κι ένα τελεία μία, οπότε
// ένα πλέγμα που τα ανακατεύει στραβώνει μόλις μια γραμμή έχει και
// τα δύο — και στραβώνει σιωπηλά, το πρόγραμμα συνεχίζει. Το 囲碁 το
// έλυσε έτσι για τη γωβάν (GO/表示/主題.zy, 盤幅(路) { <~ 2 * 路 }),
// και το δοκιμές/όψη.zy το ελέγχει με το std/term::width αντί για
// πίνακα μετρημένο στο χέρι.
//
// Καμία συμβολοσειρά που διαβάζει άνθρωπος δεν γράφεται εδώ: όλες
// έρχονται από τον διανομέα, που κρατά την ενεργή γλώσσα ως
// κατάσταση module. Γι' αυτό καμία συνάρτηση εδώ δεν παίρνει
// παράμετρο γλώσσας (USERAPPI18N.md §2).
// ============================================================

# .εμφάνιση_όψη {

    <# ../πρότυπο/τερματικό => τ
    <# ../γλώσσα/διανομέας => γ
    <# ./πλαίσιο => πλ

    #> { θέμα, ονόματα_θεμάτων, επόμενο_θέμα, καθάρισε, κατάσταση, πλέγμα,
          βοήθεια, δρομέας, χωράει, μενού, ΑΡΧΗ }

    ΟΝΟΜΑΤΑ_ΘΕΜΑΤΩΝ := ["emoji", "block", "ascii"]

    ΘΕΜΑΤΑ = #(
        emoji: #(ζ: "🟩", ν: "⬛", δζ: "🟨", δν: "🟨", χζ: 0,  χν: 0),
        block: #(ζ: "██", ν: "··", δζ: "▓▓", δν: "▒▒", χζ: 46, χν: 238),
        ascii: #(ζ: "[]", ν: " .", δζ: "<>", δν: "<>", χζ: 15, χν: 8)
    )

    ΧΡΩΜΑ_ΠΛΑΙΣΙΟΥ := 244
    ΧΡΩΜΑ_ΤΙΤΛΟΥ   := 51
    ΧΡΩΜΑ_ΔΡΟΜΕΑ   := 226
    ΧΡΩΜΑ_ΕΠΙΛΟΓΗΣ := 226

    // Η γραμμή που ξεκινά ο κόσμος: 1 η κατάσταση, 2 η γραμμή, 3 ο κόσμος.
    ΑΡΧΗ := 3
    // Πόσες γραμμές οθόνης τρώει το πλαίσιο: κατάσταση, γραμμή, βοήθεια.
    ΣΚΕΥΗ := 3

    ονόματα_θεμάτων() { <~ ΟΝΟΜΑΤΑ_ΘΕΜΑΤΩΝ }

    // (κλειδί_σφάλματος, θέμα)
    θέμα(όνομα) {
        ? ΘΕΜΑΤΑ$? όνομα { <~ ("", ΘΕΜΑΤΑ[όνομα]) }
        <~ ("σφάλμα.άγνωστο_θέμα", ΘΕΜΑΤΑ["block"])
    }

    επόμενο_θέμα(τρέχον) {
        θ = 0
        @ όνομα:ΟΝΟΜΑΤΑ_ΘΕΜΑΤΩΝ {
            θ += 1
            ? όνομα == τρέχον {
                ? θ == ΟΝΟΜΑΤΑ_ΘΕΜΑΤΩΝ$# { <~ ΟΝΟΜΑΤΑ_ΘΕΜΑΤΩΝ[1] }
                <~ ΟΝΟΜΑΤΑ_ΘΕΜΑΤΩΝ[θ + 1]
            }
        }
        <~ ΟΝΟΜΑΤΑ_ΘΕΜΑΤΩΝ[1]
    }

    // Πόσος κόσμος χωρά σε αυτή την οθόνη. ΑΥΤΟ είναι το όριο, και
    // δεν το ξεπερνά κανείς: ένας κόσμος πιο φαρδύς από την οθόνη
    // ζωγραφίζεται μισός, κι ο μισός κόσμος δεν είναι ο κόσμος —
    // τα κύτταρα που δεν φαίνονται εξακολουθούν να μετρούν γείτονες.
    // Επιστρέφει (γραμμές, στήλες) ΚΟΣΜΟΥ, ή (0, 0) όταν δεν χωρά
    // ούτε ένα κύτταρο. Το μηδέν είναι απάντηση και όχι αποτυχία: το
    // να επιστρέψει 1 σε οθόνη που δεν χωρά 1 θα ήταν ψέμα, και ο
    // καλών δεν θα είχε τρόπο να το μάθει. Η δοκιμή οθόνης το έπιασε
    // ακριβώς έτσι, σε οθόνη 1×1.
    χωράει(ύψος_οθόνης, πλάτος_οθόνης) {
        γ = ύψος_οθόνης - ΣΚΕΥΗ
        σ = πλάτος_οθόνης / 2
        ? γ < 1 || σ < 1 { <~ (0, 0) }
        <~ (γ, σ)
    }

    καθάρισε() { >>! }

    // ── Η γραμμή κατάστασης ─────────────────────────────────
    //
    // Μία γραμμή, πάντα σε όλο το πλάτος της οθόνης, και το μόνο
    // σημείο όπου το πρόγραμμα λέει κάτι για τον εαυτό του. Κάθε
    // κομμάτι της είναι μεταφρασμένο και μετρημένο· τίποτα δεν είναι
    // γεμισμένο με το χέρι.

    κατάσταση(γενιά, πληθυσμός, γραμμές, στήλες, τοροειδές, όνομα_κανόνα,
              καθυστέρηση, κλειδί_τρόπου, σχήμα, όριο, πλάτος_οθόνης) {
        αριστερά = "▸ " γ::κείμενο(κλειδί_τρόπου)

        γεν = γ::κείμενο("κατάσταση.γενιά") " " γενιά
        ? όριο > 0 { γεν = γεν "/" όριο }

        μέση = γεν "   " γ::φράση_πληθυσμού(πληθυσμός) "   " γ::φράση_κόσμου(γραμμές, στήλες, τοροειδές) "   " όνομα_κανόνα "   " γ::φράση_ρυθμού(καθυστέρηση)

        δεξιά = σχήμα
        ? δεξιά == "" { δεξιά = γ::κείμενο("κατάσταση.τίποτα") }

        γραμμή = αριστερά "   " μέση "   " δεξιά
        ? τ::πλάτος(γραμμή) > πλάτος_οθόνης { γραμμή = τ::κόψε(γραμμή, πλάτος_οθόνης) }
        >>~ (1, 1, 1, ΧΡΩΜΑ_ΤΙΤΛΟΥ, 0) > τ::αριστερή_στοίχιση(γραμμή, πλάτος_οθόνης)
        >>~ (2, 1, 0, ΧΡΩΜΑ_ΠΛΑΙΣΙΟΥ, 0) > ("─" $* πλάτος_οθόνης)
    }

    // ── Η γραμμή βοήθειας ───────────────────────────────────
    //
    // Χτίζεται μετρώντας: μπαίνουν όσα ζευγάρια πλήκτρο/έννοια
    // χωρούν, με τη σειρά, κι όχι μια συμβολοσειρά ανά μέγεθος
    // οθόνης. Η μετάφραση αλλάζει το πλάτος κάθε λέξης, οπότε καμία
    // σταθερή γραμμή δεν είναι σωστή σε δεύτερη γλώσσα — και η
    // κομμένη στη μέση κρύβει το πλήκτρο της εξόδου, που το έπιασε η
    // δοκιμή οθόνης με την πρώτη.

    // Χωρίς κάτω παύλα: μια ΣΤΑΘΕΡΑ module με «_» μπροστά δεν
    // διαβάζεται μέσα από βρόχο — ο κανόνας του «_» είναι για
    // μεταβλητές και τη σέβονται και οι δύο μηχανές. (Για
    // ΣΥΝΑΡΤΗΣΕΙΣ η ίδια γραφή διαφωνεί μεταξύ μηχανών:
    // HALLAZGOS.md, BUG-GOL-002.)
    ΠΛΗΚΤΡΑ := [
        ("↑↓←→",  "πλήκτρο.κίνηση"),
        ("SPACE", "πλήκτρο.εναλλαγή"),
        ("↵",     "πλήκτρο.εκκίνηση"),
        ("n",     "πλήκτρο.βήμα"),
        ("p",     "πλήκτρο.σχήμα"),
        ("c",     "πλήκτρο.καθάρισμα"),
        ("r",     "πλήκτρο.τυχαίο"),
        ("t",     "πλήκτρο.θέμα"),
        ("l",     "πλήκτρο.γλώσσα"),
        ("+/-",   "πλήκτρο.ταχύτητα")
    ]

    βοήθεια(ύψος_οθόνης, πλάτος_οθόνης) {
        // Η έξοδος μπαίνει πρώτη στο μέτρημα και τελευταία στη
        // γραμμή: ό,τι κι αν κοπεί, το πλήκτρο που κλείνει το
        // πρόγραμμα μένει.
        έξοδος = "q " γ::κείμενο("πλήκτρο.έξοδος")
        γραμμή = ""
        @ (πλήκτρο, κλειδί):ΠΛΗΚΤΡΑ {
            κομμάτι = πλήκτρο " " γ::κείμενο(κλειδί)
            δοκιμή = γραμμή
            ? δοκιμή <> "" { δοκιμή = δοκιμή "  " }
            δοκιμή = δοκιμή κομμάτι
            ? τ::πλάτος(δοκιμή) + τ::πλάτος(έξοδος) + 2 > πλάτος_οθόνης { @! }
            γραμμή = δοκιμή
        }
        ? γραμμή <> "" { γραμμή = γραμμή "  " }
        γραμμή = γραμμή έξοδος
        ? τ::πλάτος(γραμμή) > πλάτος_οθόνης { γραμμή = τ::κόψε(γραμμή, πλάτος_οθόνης) }
        >>~ (ύψος_οθόνης, 1, 0, ΧΡΩΜΑ_ΠΛΑΙΣΙΟΥ, 0) > τ::αριστερή_στοίχιση(γραμμή, πλάτος_οθόνης)
    }

    // ── Το πλέγμα ───────────────────────────────────────────
    //
    // Μια γραμμή ζωγραφίζεται σε ΚΟΜΜΑΤΙΑ ίδιας κατάστασης κι όχι
    // κύτταρο-κύτταρο, ώστε ένας σχεδόν άδειος κόσμος να κοστίζει
    // λίγες εγγραφές ανά γραμμή αντί για μία ανά στήλη.

    _κομμάτι(θ, ζωντανό, μήκος) {
        ? ζωντανό { <~ (θ.ζ $* μήκος, θ.χζ) }
        <~ (θ.ν $* μήκος, θ.χν)
    }

    πλέγμα(π, θ, ορατές_γραμμές, ορατές_στήλες) {
        γ = 0
        @ σειρά:π {
            γ += 1
            ? γ > ορατές_γραμμές { <~ }
            σ = 0
            αρχή_κομματιού = 1
            τρέχον = -1
            @ κύτταρο:σειρά {
                σ += 1
                ? σ > ορατές_στήλες { σ -= 1
                                      @! }
                ? τρέχον == -1 { τρέχον = κύτταρο }
                ? κύτταρο <> τρέχον {
                    (κείμενο, χρώμα) = _κομμάτι(θ, τρέχον == 1, σ - αρχή_κομματιού)
                    >>~ (ΑΡΧΗ + γ - 1, (αρχή_κομματιού - 1) * 2 + 1, 0, χρώμα, 0) > κείμενο
                    αρχή_κομματιού = σ
                    τρέχον = κύτταρο
                }
            }
            ? τρέχον <> -1 {
                (κείμενο, χρώμα) = _κομμάτι(θ, τρέχον == 1, σ - αρχή_κομματιού + 1)
                >>~ (ΑΡΧΗ + γ - 1, (αρχή_κομματιού - 1) * 2 + 1, 0, χρώμα, 0) > κείμενο
            }
        }
    }

    δρομέας(θ, γ, σ, ζωντανό) {
        ? ζωντανό { >>~ (ΑΡΧΗ + γ - 1, (σ - 1) * 2 + 1, 1, ΧΡΩΜΑ_ΔΡΟΜΕΑ, 0) > θ.δζ }
        _ { >>~ (ΑΡΧΗ + γ - 1, (σ - 1) * 2 + 1, 1, ΧΡΩΜΑ_ΔΡΟΜΕΑ, 0) > θ.δν }
    }

    // ── Μενού ───────────────────────────────────────────────
    //
    // Τα δεδομένα μπαίνουν, το πλαίσιο βγαίνει. Το σημάδι επιλογής
    // μπαίνει ΠΡΙΝ μετρηθεί η γραμμή, ώστε το πλαίσιο να έχει χώρο
    // γι' αυτό σε κάθε γλώσσα και οι γραμμές να μη χοροπηδούν όταν
    // κινείται ο δρομέας (USERAPPI18N.md §6).

    μενού(κλειδί_τίτλου, επιλογές, θέση, ύψος_οθόνης, πλάτος_οθόνης) {
        γραμμές = [πλ::κεντρική(γ::κείμενο(κλειδί_τίτλου)), πλ::χώρισμα()]
        δ = 0
        @ κείμενο:επιλογές {
            δ += 1
            σημάδι = "  "
            ? δ == θέση { σημάδι = "▸ " }
            γραμμές$+ πλ::κανονική(σημάδι κείμενο)
        }
        γραμμές$+ πλ::χώρισμα()
        γραμμές$+ πλ::κεντρική("↑↓ " γ::κείμενο("πλήκτρο.κίνηση") "   ↵ " γ::κείμενο("πλήκτρο.επιλογή") "   esc " γ::κείμενο("πλήκτρο.άκυρο"))

        κουτί = πλ::χτίσε(γραμμές, 2)
        ύψος_κουτιού = κουτί$#
        πλάτος_κουτιού = τ::πλάτος(κουτί[1])
        γ0 = (ύψος_οθόνης - ύψος_κουτιού) / 2 + 1
        σ0 = (πλάτος_οθόνης - πλάτος_κουτιού) / 2 + 1
        ? γ0 < 1 { γ0 = 1 }
        ? σ0 < 1 { σ0 = 1 }

        δ = 0
        @ γρ:κουτί {
            χρώμα = ΧΡΩΜΑ_ΠΛΑΙΣΙΟΥ
            ? δ == θέση + 1 { χρώμα = ΧΡΩΜΑ_ΕΠΙΛΟΓΗΣ }
            >>~ (γ0 + δ, σ0, 0, χρώμα, 0) > γρ
            δ += 1
        }
    }
}
