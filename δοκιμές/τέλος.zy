// ============================================================
// δοκιμές/τέλος.zy — πότε ο κόσμος σταματά.
//
// Η Ζωή δεν τελειώνει μόνη της, οπότε το πρόγραμμα πρέπει να ξέρει
// πότε δεν έχει νόημα να συνεχίσει: όταν όλα πέθαναν, όταν το καρέ
// είναι ίδιο με το προηγούμενο, κι όταν επαναλαμβάνει ένα καρέ που
// έχει ήδη δείξει. Οι περίοδοι που ελέγχονται εδώ είναι οι γνωστές
// περίοδοι των ταλαντωτών, όχι ό,τι έτυχε να βγάλει η μηχανή.
// ============================================================

# .δοκιμές_τέλος {

    <# ../πυρήνας/κόσμος => κ
    <# ../πυρήνας/σχήματα => σ
    <# ./βεβαίωση => β

    #> { τρέξε }

    στήσε(πλευρά, όνομα, γ0, σ0) {
        (μήνυμα, κελιά) = σ::πάρε(όνομα)
        ? μήνυμα <> "" { <~ [] }
        <~ σ::τοποθέτησε(κ::νέος(πλευρά, πλευρά), κελιά, γ0, σ0)
    }

    τρέξε_ως_το_τέλος(π, γέννηση, επιβίωση, τοροειδές, όριο) {
        ιστορικό = []
        γενιά = 0
        @ όριο {
            ιστορικό = κ::θύμησε(ιστορικό, π)
            π = κ::βήμα(π, γέννηση, επιβίωση, τοροειδές)
            γενιά += 1
            (αιτία, περίοδος) = κ::διάγνωση(π, ιστορικό)
            ? αιτία <> "" { <~ (αιτία, περίοδος, γενιά) }
        }
        <~ ("", 0, γενιά)
    }

    // σιωπή = #1: τυπώνει μόνο ό,τι απέτυχε. Επιστρέφει το πλήθος
    // των αποτυχιών, που είναι και ο κωδικός εξόδου του δρομέα.
    τρέξε(σιωπή) {
        β::ξεκίνα_σουίτα("το τέλος", σιωπή)

        // Τρέχει ώσπου να διαγνωστεί τέλος, ή ώσπου να σκάσει το όριο.
        // Επιστρέφει (αιτία, περίοδος, γενιά).

        (_σφ, ΓΕΝ, ΕΠΙ) = κ::κανόνας("B3/S23")

        β::τμήμα("ένας άδειος κόσμος είναι ήδη τέλος")
        (α1, π1) = κ::διάγνωση(κ::νέος(8, 8), [])
        β::ίσο("άδειος: αιτία", α1, "εξαφάνιση")
        β::ίσο("άδειος: περίοδος", π1, 0)

        β::τμήμα("ένα ακίνητο σχήμα παγώνει στην πρώτη γενιά")
        @ όνομα:["block", "beehive", "loaf", "boat", "tub"] {
            (α, π, γεν) = τρέξε_ως_το_τέλος(στήσε(20, όνομα, 6, 6), ΓΕΝ, ΕΠΙ, #1, 30)
            β::ίσο(όνομα ": αιτία", α, "ακίνητο")
            β::ίσο(όνομα ": περίοδος", π, 1)
            β::ίσο(όνομα ": γενιά", γεν, 1)
        }

        β::τμήμα("ένας ταλαντωτής αναγνωρίζεται με τη σωστή περίοδο")
        @ (όνομα, πλευρά, αναμενόμενη):[("blinker", 16, 2), ("toad", 16, 2), ("beacon", 16, 2), ("pulsar", 32, 3), ("pentadecathlon", 40, 15)] {
            (α, π, γεν) = τρέξε_ως_το_τέλος(στήσε(πλευρά, όνομα, 6, 6), ΓΕΝ, ΕΠΙ, #1, 60)
            β::ίσο(όνομα ": αιτία", α, "ταλάντωση")
            β::ίσο(όνομα ": περίοδος", π, αναμενόμενη)
            β::ίσο(όνομα ": πιάστηκε στη γενιά", γεν, αναμενόμενη)
        }

        β::τμήμα("το diehard σβήνει, και το λέει")
        (α2, _π2, γεν2) = τρέξε_ως_το_τέλος(στήσε(60, "diehard", 25, 25), ΓΕΝ, ΕΠΙ, #1, 300)
        β::ίσο("diehard: αιτία", α2, "εξαφάνιση")
        β::ίσο("diehard: γενιά", γεν2, 130)

        β::τμήμα("ένα διαστημόπλοιο ΔΕΝ είναι ακίνητο")
        // Ο ολισθητής επαναλαμβάνει το σχήμα του κάθε 4 γενιές αλλά σε άλλη
        // θέση, οπότε δεν είναι ο ίδιος κόσμος. Σε τόρο 20×20 γυρίζει στην
        // αρχική του θέση μετά από 80 γενιές — μέσα στη μνήμη των 16 δεν
        // φαίνεται, και σωστά: ένα σχήμα που ταξιδεύει δεν έχει σταματήσει.
        (α3, _π3, _γ3) = τρέξε_ως_το_τέλος(στήσε(20, "glider", 5, 5), ΓΕΝ, ΕΠΙ, #1, 40)
        β::ίσο("glider δεν διαγιγνώσκεται ως τέλος", α3, "")

        β::τμήμα("η μνήμη κρατά ΜΝΗΜΗ γενιές και όχι μία παραπάνω")
        ιστ = []
        @ 20 { ιστ = κ::θύμησε(ιστ, κ::νέος(2, 2)) }
        β::ίσο("μήκος ιστορικού", ιστ$#, κ.ΜΝΗΜΗ)
        β::αληθές("ΜΝΗΜΗ φτάνει για pentadecathlon", κ.ΜΝΗΜΗ > 15)

        β::τμήμα("το πιο πρόσφατο μπαίνει μπροστά")
        α = κ::νέος(2, 2)
        γ_ = κ::νέος(2, 2)
        γ_[1>1]$~ 1
        ιστ2 = κ::θύμησε(κ::θύμησε([], α), γ_)
        β::αληθές("πρώτο είναι το τελευταίο που μπήκε", κ::ίσοι(ιστ2[1], γ_))
        β::αληθές("δεύτερο είναι το προηγούμενο", κ::ίσοι(ιστ2[2], α))

        <~ β::σύνοψη("το τέλος")
    }
}
