// φαίνονται: ΤΕΛΟΣ, πάγωσε.
<# ../../εκκίνηση => εκ
<~ εκ::ξεκίνα("el", ["-p", "block", "-r", "10", "-c", "10", "-t", "ascii", "-d", "20", "--run"])
