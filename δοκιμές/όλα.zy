// ============================================================
// δοκιμές/όλα.zy — ο δρομέας των δοκιμών, γραμμένος σε Zymbol.
//
//   zymbol run       δοκιμές/όλα.zy          όλες οι σουίτες
//   zymbol run --vm  δοκιμές/όλα.zy          στη μηχανή καταχωρητών
//   zymbol run       δοκιμές/όλα.zy -v       με κάθε ✓
//   zymbol run       δοκιμές/όλα.zy κόσμος   μία σουίτα
//
// Δεν υπάρχει shell πουθενά. Ο δρομέας ΕΙΣΑΓΕΙ τις σουίτες ως
// modules και τις καλεί, οπότε είναι το ίδιο πράγμα με αυτό που
// δοκιμάζει: αν σπάσουν τα modules, σπάει κι ο δρομέας, και το
// μαθαίνεις από το ίδιο τρέξιμο.
//
// Ένα script σε shell θα έκανε την ίδια δουλειά και θα έλεγε ένα
// ψέμα: ότι για να τρέξεις προγράμματα Zymbol χρειάζεσαι κάτι που
// δεν είναι Zymbol. Ο κωδικός εξόδου είναι το πλήθος των αποτυχιών,
// φραγμένο στο 1, ώστε `&&` στο κέλυφος να σημαίνει κάτι.
//
// EN: δοκιμές/όλα.zy — the test runner, written in Zymbol. It
// imports the suites as modules and calls them; no shell anywhere.
// ============================================================

<# ./κόσμος => δ_κόσμος
<# ./τέλος => δ_τέλος
<# ./γλώσσα => δ_γλώσσα
<# ./όψη => δ_όψη
<# ./εκκίνηση => δ_εκκίνηση
<# ./βεβαίωση => β
<# ../πρότυπο/τερματικό => τ

ΟΝΟΜΑΤΑ := ["κόσμος", "τέλος", "γλώσσα", "όψη", "εκκίνηση"]

>< args

σιωπή = #1
ζητούμενες = []
άγνωστη = ""

@ όρισμα:args {
    ? όρισμα == "-v" || όρισμα == "--verbose" { σιωπή = #0
                                                @> }
    γνωστή = #0
    @ ν:ΟΝΟΜΑΤΑ { ? ν == όρισμα { γνωστή = #1 } }
    ? γνωστή { ζητούμενες$+ όρισμα } _ { άγνωστη = όρισμα }
}

? άγνωστη <> "" {
    >> "δεν υπάρχει σουίτα «" άγνωστη "»" ¶
    >> "σουίτες: " ¶
    @ ν:ΟΝΟΜΑΤΑ { >> "  " ν ¶ }
    <~ 2
}

θέλουμε(όνομα, ζητ) {
    ? ζητ$# == 0 { <~ #1 }
    @ ν:ζητ { ? ν == όνομα { <~ #1 } }
    <~ #0
}

αποτυχίες = 0

? θέλουμε("κόσμος", ζητούμενες)   { αποτυχίες += δ_κόσμος::τρέξε(σιωπή) }
? θέλουμε("τέλος", ζητούμενες)    { αποτυχίες += δ_τέλος::τρέξε(σιωπή) }
? θέλουμε("γλώσσα", ζητούμενες)   { αποτυχίες += δ_γλώσσα::τρέξε(σιωπή) }
? θέλουμε("όψη", ζητούμενες)      { αποτυχίες += δ_όψη::τρέξε(σιωπή) }
? θέλουμε("εκκίνηση", ζητούμενες) { αποτυχίες += δ_εκκίνηση::τρέξε(σιωπή) }

>> ("─" $* 44) ¶
σύνολο = β::σύνολο_δοκιμών()
? αποτυχίες == 0 {
    >> "  ΟΛΑ ΠΡΑΣΙΝΑ           " τ::δεξιά_στοίχιση("" σύνολο, 4) " δοκιμές" ¶
    <~ 0
}
>> "  ΚΟΚΚΙΝΟ               " τ::δεξιά_στοίχιση("" αποτυχίες, 4) " από " σύνολο ¶
<~ 1
