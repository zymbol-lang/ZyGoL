// ============================================================
// δοκιμές/βεβαίωση.zy — οι βεβαιώσεις των δοκιμών.
//
// Οι δοκιμές αποφασίζουν μόνες τους αν πέρασαν, μέσα σε Zymbol, και
// ο δρομέας τους (δοκιμές/όλα.zy) είναι κι αυτός Zymbol: εισάγει τις
// σουίτες ως modules και τις καλεί. Δεν μπαίνει shell πουθενά — ένα
// .zy που τυπώνει «ΠΕΡΑΣΕ» χωρίς να ελέγχει τίποτα περνά κάθε grep,
// κι ένα που κρασάρει στη μέση δεν τυπώνει ποτέ FAIL.
//
// Δύο ζευγάρια μετρητών: το ένα μηδενίζεται σε κάθε σουίτα, το άλλο
// κρατά το σύνολο. Είναι κατάσταση module, που η Zymbol τη μοιράζεται
// ανά διαδρομή αρχείου, οπότε και οι πέντε σουίτες μετρούν στον ίδιο
// μετρητή χωρίς να τον περνά κανείς από συνάρτηση σε συνάρτηση.
// ============================================================

# .δοκιμές_βεβαίωση {

    <# ../πρότυπο/τερματικό => τ

    #> { ίσο, αληθές, σύνοψη, ξεκίνα_σουίτα, τμήμα, σύνολο_δοκιμών, σύνολο_αποτυχιών }

    δοκιμές = 0
    αποτυχίες = 0
    όλες_οι_δοκιμές = 0
    όλες_οι_αποτυχίες = 0
    σιωπηλά = 0

    // σιωπή = #1 τυπώνει μόνο τις αποτυχίες. Ο δρομέας το θέλει:
    // πέντε σουίτες με κάθε ✓ τους είναι διακόσιες γραμμές που
    // κανείς δεν διαβάζει, και μέσα τους κρύβεται η μία που μετράει.
    ξεκίνα_σουίτα(τίτλος, σιωπή) {
        δοκιμές = 0
        αποτυχίες = 0
        σιωπηλά = 0
        ? σιωπή { σιωπηλά = 1 }
        ? !σιωπή { >> "── " τίτλος " ──" ¶ }
        <~ 0
    }

    // Επικεφαλίδα ενότητας — φαίνεται μόνο όταν δεν είμαστε σιωπηλοί.
    τμήμα(τίτλος) {
        ? σιωπηλά == 0 { >> "── " τίτλος " ──" ¶ }
        <~ 0
    }

    _ανάφερε(όνομα, εντάξει, λεπτομέρεια) {
        δοκιμές += 1
        όλες_οι_δοκιμές += 1
        ? εντάξει {
            ? σιωπηλά == 0 { >> "  ✓ " όνομα ¶ }
            <~ 0
        }
        αποτυχίες += 1
        όλες_οι_αποτυχίες += 1
        >> "  ✗ " όνομα ¶
        >> "      " λεπτομέρεια ¶
        <~ 0
    }

    ίσο(όνομα, πήρα, περίμενα) {
        _ανάφερε(όνομα, πήρα == περίμενα, "περίμενα «" περίμενα "» και πήρα «" πήρα "»")
        <~ 0
    }

    αληθές(όνομα, τιμή) {
        _ανάφερε(όνομα, τιμή, "περίμενα #1 και πήρα «" τιμή "»")
        <~ 0
    }

    σύνολο_δοκιμών() { <~ όλες_οι_δοκιμές }
    σύνολο_αποτυχιών() { <~ όλες_οι_αποτυχίες }

    // Επιστρέφει τις αποτυχίες ΑΥΤΗΣ της σουίτας.
    σύνοψη(τίτλος) {
        ? αποτυχίες == 0 {
            >> "  ✔ " τ::αριστερή_στοίχιση(τίτλος, 22) " " τ::δεξιά_στοίχιση("" δοκιμές, 4) " δοκιμές" ¶
            <~ 0
        }
        >> "  ✘ " τ::αριστερή_στοίχιση(τίτλος, 22) " " τ::δεξιά_στοίχιση("" αποτυχίες, 4) " από " δοκιμές ¶
        <~ αποτυχίες
    }
}
