// ============================================================
// δοκιμές/έξοδος.zy — τι ΛΕΕΙ το πρόγραμμα, όχι μόνο με τι βγαίνει.
//
// Το δοκιμές/εκκίνηση.zy καλεί την εκ::ξεκίνα() μέσα στην ίδια
// διεργασία και ελέγχει μόνο τον κωδικό εξόδου, γιατί ό,τι τυπώνει
// ο κώδικας δεν πιάνεται από μέσα (HALLAZGOS.md, GAP-GOL-010). Εδώ
// το πρόγραμμα τρέχει ως υποσενάριο, `</ ../ζωή.zy … />`, με τα δικά
// του ορίσματα (D10), και η έξοδός του γυρίζει ως τιμή: κείμενο αν
// βγήκε με 0, σφάλμα ##IO με τον κωδικό μπροστά αν όχι (D2).
//
// Τα ορίσματα είναι κυριολεκτικά, όπως η διαδρομή, οπότε η σουίτα
// είναι ένας πίνακας από κλήσεις — μία ανά γραμμή, όπως θα τις έγραφε
// κανείς στη γραμμή εντολών.
//
// Ό,τι περιμένουμε δεν είναι γραμμένο εδώ με το χέρι: έρχεται από τον
// ίδιο κατάλογο που χρησιμοποιεί το πρόγραμμα, οπότε η δοκιμή λέει
// «είπε αυτό που λέει ο κατάλογος στη γλώσσα που ζητήθηκε».
//
// Αυτόνομο σενάριο, όχι module του όλα.zy: η μηχανή του browser δεν
// έχει διεργασίες για να τρέξει υποσενάριο, και το όλα.zy είναι η
// σουίτα που συμφωνεί και στις τρεις μηχανές.
//
// EN: what the program SAYS, run as a subscript with its own literal
// arguments; the expected text comes from the program's own catalogue.
// ============================================================

<# ./βεβαίωση => β
<# ../γλώσσα/διανομέας => γ
<# ../πυρήνας/σχήματα => σ

// Το μήνυμα ενός σφάλματος ##IO, ή "" αν το πρόγραμμα βγήκε με 0.
_αποτυχία(αποτέλεσμα) {
    <~ ?? αποτέλεσμα {
        ##IO(μ) => μ
        _       => ""
    }
}

// Ένα κλειδί του καταλόγου σε μια γλώσσα, χωρίς να αφήσει τη γλώσσα
// αλλαγμένη για ό,τι ακολουθεί.
_στα(κωδικός, κλειδί) {
    γ::όρισε(κωδικός)
    κείμενο = γ::κείμενο(κλειδί)
    γ::όρισε("el")
    <~ κείμενο
}

// Ο κατάλογος στη γλώσσα `κωδικός`: βγήκε με 0, έχει τον τίτλο, και
// ονομάζει κάθε σχήμα με το αναγνωριστικό και τη μετάφρασή του.
_κατάλογος(κωδικός, έξοδος) {
    β::αληθές(κωδικός ": βγήκε με 0", έξοδος$! == #0)
    β::αληθές(κωδικός ": ο τίτλος", έξοδος$? _στα(κωδικός, "χρήση.σχήματα"))
    λείπουν = 0
    @ όνομα:σ::ονόματα() {
        ? !(έξοδος$? όνομα) { λείπουν += 1 }
        ? !(έξοδος$? _στα(κωδικός, "σχήμα." όνομα)) { λείπουν += 1 }
    }
    β::ίσο(κωδικός ": κάθε σχήμα, με το όνομα και τη μετάφρασή του", λείπουν, 0)
    <~ 0
}

β::ξεκίνα_σουίτα("έξοδος", #0)

β::τμήμα("ο κατάλογος ονομάζει κάθε σχήμα, στη γλώσσα που ζητήθηκε")
_κατάλογος("el", </ ../ζωή.zy -L el --list />)
_κατάλογος("es", </ ../ζωή.zy -L es --list />)
_κατάλογος("en", </ ../ζωή.zy -L en --list />)
_κατάλογος("hi", </ ../ζωή.zy -L hi --list />)

β::τμήμα("ένας κακός κανόνας λέγεται στη γλώσσα του χρήστη, με κωδικό 2")
β::ίσο("es B3S23",  _αποτυχία(</ ../ζωή.zy -L es -R B3S23 -b />),
       "exit 2: error: " _στα("es", "σφάλμα.κανόνας_μορφή"))
β::ίσο("en 3/23",   _αποτυχία(</ ../ζωή.zy -L en -R 3/23 -b />),
       "exit 2: error: " _στα("en", "σφάλμα.κανόνας_γράμμα"))
β::ίσο("hi B9/S23", _αποτυχία(</ ../ζωή.zy -L hi -R B9/S23 -b />),
       "exit 2: error: " _στα("hi", "σφάλμα.κανόνας_ψηφίο"))
β::ίσο("el /S23",   _αποτυχία(</ ../ζωή.zy -L el -R /S23 -b />),
       "exit 2: error: " _στα("el", "σφάλμα.κανόνας_κενό"))

β::τμήμα("άγνωστο σχήμα και άγνωστη επιλογή")
β::ίσο("άγνωστο σχήμα", _αποτυχία(</ ../ζωή.zy -L en -p spaceship -b />),
       "exit 2: error: " _στα("en", "σφάλμα.άγνωστο_σχήμα"))
β::ίσο("άγνωστη επιλογή", _αποτυχία(</ ../ζωή.zy -L es --δεν-υπάρχει />),
       "exit 2: error: " _στα("es", "σφάλμα.άγνωστη_επιλογή"))

β::τμήμα("μια παρτίδα λέει σε ποια γενιά είναι")
παρτίδα = </ ../ζωή.zy -L es -p blinker -r 8 -c 8 -b />
β::αληθές("blinker: βγήκε με 0", παρτίδα$! == #0)
β::αληθές("blinker: γράφει «γενιά» στα ισπανικά", παρτίδα$? _στα("es", "κατάσταση.γενιά"))

αποτυχίες = β::σύνοψη("έξοδος")
? αποτυχίες <> 0 { <~ 1 }
