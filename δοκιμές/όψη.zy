// ============================================================
// δοκιμές/όψη.zy — η γεωμετρία της οθόνης.
//
// Δύο ιδιότητες που δεν φαίνονται διαβάζοντας τον κώδικα και που
// σπάνε σιωπηλά — το πρόγραμμα συνεχίζει να τρέχει και μόνο δείχνει
// λάθος:
//
//   1. κάθε σημάδι κάθε θέματος πιάνει ακριβώς δύο στήλες
//   2. ένα πλαίσιο έχει την ίδια στοίχιση σε κάθε γλώσσα
//
// Το δεύτερο είναι ο λόγος που υπάρχει το εμφάνιση/πλαίσιο.zy: η
// μετάφραση αλλάζει το πλάτος κάθε λέξης, και ένα κουτί γραμμένο ως
// literal με το γέμισμά του μέσα ξεκουρδίζεται στη δεύτερη γλώσσα.
// ============================================================

# .δοκιμές_όψη {

    <# ../εμφάνιση/όψη => ό
    <# ../εμφάνιση/πλαίσιο => πλ
    <# ../γλώσσα/διανομέας => γ
    <# ../πρότυπο/τερματικό => τ
    <# ./βεβαίωση => β

    #> { τρέξε }



    // σιωπή = #1: τυπώνει μόνο ό,τι απέτυχε. Επιστρέφει το πλήθος
    // των αποτυχιών, που είναι και ο κωδικός εξόδου του δρομέα.
    τρέξε(σιωπή) {
        β::ξεκίνα_σουίτα("εμφάνιση", σιωπή)

        β::τμήμα("κάθε σημάδι κάθε θέματος πιάνει δύο στήλες")
        @ όνομα:ό::ονόματα_θεμάτων() {
            (μήνυμα, θ) = ό::θέμα(όνομα)
            β::ίσο(όνομα ": γνωστό θέμα", μήνυμα, "")
            β::ίσο(όνομα " ζωντανό", τ::πλάτος(θ.ζ), 2)
            β::ίσο(όνομα " νεκρό", τ::πλάτος(θ.ν), 2)
            β::ίσο(όνομα " δρομέας πάνω σε ζωντανό", τ::πλάτος(θ.δζ), 2)
            β::ίσο(όνομα " δρομέας πάνω σε νεκρό", τ::πλάτος(θ.δν), 2)
        }
        (μ_άγνωστο, _θ2) = ό::θέμα("neon")
        β::ίσο("άγνωστο θέμα αναφέρεται, δεν μαντεύεται", μ_άγνωστο, "σφάλμα.άγνωστο_θέμα")

        β::τμήμα("τα θέματα γυρίζουν κύκλο")
        ονόματα_θ = ό::ονόματα_θεμάτων()
        τρέχον = ονόματα_θ[1]
        @ ονόματα_θ$# { τρέχον = ό::επόμενο_θέμα(τρέχον) }
        β::ίσο("μετά από όλα τα θέματα γυρίζει στο πρώτο", τρέχον, ονόματα_θ[1])

        β::τμήμα("ο κόσμος δεν ξεπερνά την οθόνη")
        @ (ύψος, πλάτος, α_γ, α_σ):[(24, 80, 21, 40), (40, 120, 37, 60), (10, 20, 7, 10), (4, 4, 1, 2), (4, 2, 1, 1), (3, 80, 0, 0), (4, 1, 0, 0), (1, 1, 0, 0)] {
            (γρ, στ) = ό::χωράει(ύψος, πλάτος)
            β::ίσο("οθόνη " ύψος "×" πλάτος " → γραμμές", γρ, α_γ)
            β::ίσο("οθόνη " ύψος "×" πλάτος " → στήλες", στ, α_σ)
            // Ό,τι λέει ότι χωρά, χωρά πράγματι· ό,τι δεν χωρά λέει μηδέν.
            ? γρ > 0 {
                β::αληθές("οθόνη " ύψος "×" πλάτος ": οι στήλες χωρούν", στ * 2 <= πλάτος)
                β::αληθές("οθόνη " ύψος "×" πλάτος ": οι γραμμές χωρούν", γρ + ό.ΑΡΧΗ <= ύψος + 1)
            } _ {
                β::ίσο("οθόνη " ύψος "×" πλάτος ": δεν χωρά τίποτα", στ, 0)
            }
        }

        β::τμήμα("ένα πλαίσιο έχει την ίδια στοίχιση σε κάθε γλώσσα")
        // Το ίδιο περιεχόμενο, τέσσερις γλώσσες: μέσα σε κάθε γλώσσα κάθε
        // γραμμή έχει ακριβώς το ίδιο πλάτος. Αυτή είναι η αναλλοίωτη.
        @ κωδικός:γ::γλώσσες() {
            γ::όρισε(κωδικός)
            γραμμές = [
                πλ::κεντρική(γ::κείμενο("μενού.σχήματα")),
                πλ::χώρισμα(),
                πλ::κανονική("▸ " γ::κείμενο("σχήμα.pentadecathlon")),
                πλ::κανονική("  " γ::κείμενο("σχήμα.gosper")),
                πλ::κανονική("  " γ::κείμενο("κατηγορία.διαστημόπλοιο")),
                πλ::χώρισμα(),
                πλ::κεντρική(γ::κείμενο("πλήκτρο.επιλογή"))
            ]
            κουτί = πλ::χτίσε(γραμμές, 2)
            πλάτος_1 = τ::πλάτος(κουτί[1])
            όλες_ίδιες = #1
            @ γρ:κουτί { ? τ::πλάτος(γρ) <> πλάτος_1 { όλες_ίδιες = #0 } }
            β::αληθές("[" κωδικός "] κάθε γραμμή έχει το ίδιο πλάτος (" πλάτος_1 ")", όλες_ίδιες)
            β::αληθές("[" κωδικός "] το κουτί χωρά το περιεχόμενό του", πλάτος_1 >= τ::πλάτος(γ::κείμενο("σχήμα.pentadecathlon")) + 6)
        }
        γ::όρισε("el")

        β::τμήμα("το κουτί μεγαλώνει με τη μετάφραση, δεν την κόβει")
        // Το ίδιο κλειδί σε δύο γλώσσες με διαφορετικό πλάτος δίνει δύο
        // διαφορετικά κουτιά. Αν έδινε το ίδιο, κάπου θα είχε κοπεί κείμενο.
        γ::όρισε("en")
        πλ_en = πλ::πλάτος_από([πλ::κανονική(γ::κείμενο("σφάλμα.κανόνας_μορφή"))])
        γ::όρισε("hi")
        πλ_hi = πλ::πλάτος_από([πλ::κανονική(γ::κείμενο("σφάλμα.κανόνας_μορφή"))])
        γ::όρισε("el")
        πλ_el = πλ::πλάτος_από([πλ::κανονική(γ::κείμενο("σφάλμα.κανόνας_μορφή"))])
        β::αληθές("το αγγλικό μετριέται", πλ_en > 0)
        β::αληθές("το χίντι μετριέται", πλ_hi > 0)
        β::αληθές("το ελληνικό μετριέται", πλ_el > 0)
        β::αληθές("τα πλάτη δεν είναι όλα ίδια", (πλ_en <> πλ_el) || (πλ_hi <> πλ_el))

        β::τμήμα("το χώρισμα δεν μετράει στο πλάτος")
        β::ίσο("μόνο χώρισμα → πλάτος 0", πλ::πλάτος_από([πλ::χώρισμα()]), 0)
        β::ίσο("κείμενο και χώρισμα → το κείμενο", πλ::πλάτος_από([πλ::κανονική("abcd"), πλ::χώρισμα()]), 4)

        <~ β::σύνοψη("εμφάνιση")
    }
}
