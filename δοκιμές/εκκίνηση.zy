// ============================================================
// δοκιμές/εκκίνηση.zy — η γραμμή εντολών, από μέσα.
//
// Το εκκίνηση.zy είναι module, κι η ξεκίνα() παίρνει τα ορίσματα ως
// πίνακα. Οπότε ολόκληρη η γραμμή εντολών δοκιμάζεται από Zymbol:
// δεν χρειάζεται shell να τρέξει το πρόγραμμα και να διαβάσει την
// έξοδό του, και δεν χρειάζεται python να κρίνει τι σημαίνει.
//
// Ό,τι δεν ανοίγει οθόνη δοκιμάζεται εδώ. Ο διαδραστικός βρόχος
// δοκιμάζεται στο δοκιμές/οθόνη/, με εικονική οθόνη και πλήκτρα από
// αρχείο (zymbol run --keys, GAP-GOL-009).
//
// Οι κωδικοί εξόδου: 0 εντάξει, 2 λάθος χρήση.
// ============================================================

# .δοκιμές_εκκίνηση {

    <# ../εκκίνηση => εκ
    <# ./βεβαίωση => β

    #> { τρέξε }



    // σιωπή = #1: τυπώνει μόνο ό,τι απέτυχε. Επιστρέφει το πλήθος
    // των αποτυχιών, που είναι και ο κωδικός εξόδου του δρομέα.
    τρέξε(σιωπή) {
        β::ξεκίνα_σουίτα("εκκίνηση", σιωπή)

        // Ό,τι ακολουθεί ως το ✔ είναι η ΕΞΟΔΟΣ ΤΟΥ ΠΡΟΓΡΑΜΜΑΤΟΣ που
        // δοκιμάζεται, όχι της δοκιμής: η ξεκίνα() καλείται μέσα στην
        // ίδια διεργασία, και ό,τι τυπώνει ο κώδικας δεν πιάνεται από
        // μέσα. Εδώ ελέγχεται ο κωδικός εξόδου. Το τι ΛΕΕΙ το πρόγραμμα
        // το ελέγχει το δοκιμές/έξοδος.zy, τρέχοντάς το ως υποσενάριο
        // με δικά του ορίσματα (HALLAZGOS.md, GAP-GOL-010).
        >> "  ┌ έξοδος του δοκιμαζόμενου προγράμματος ──────────" ¶

        β::τμήμα("σωστές χρήσεις γυρίζουν 0")
        β::ίσο("κατάλογος", εκ::ξεκίνα("el", ["--list"]), 0)
        β::ίσο("βοήθεια", εκ::ξεκίνα("el", ["--help"]), 0)
        β::ίσο("παρτίδα με σχήμα", εκ::ξεκίνα("el", ["-p", "glider", "-r", "10", "-c", "10", "-b", "-n", "4"]), 0)
        β::ίσο("παρτίδα τυχαία", εκ::ξεκίνα("el", ["-x", "-s", "7", "-r", "12", "-c", "12", "-b", "-n", "5"]), 0)
        β::ίσο("παρτίδα φραγμένη", εκ::ξεκίνα("el", ["-p", "blinker", "-r", "8", "-c", "8", "-e", "-b", "-n", "2"]), 0)
        β::ίσο("άλλος κανόνας", εκ::ξεκίνα("el", ["-R", "B36/S23", "-p", "acorn", "-r", "12", "-c", "12", "-b", "-n", "3"]), 0)
        β::ίσο("άλλη γλώσσα", εκ::ξεκίνα("el", ["-L", "es", "-p", "block", "-r", "8", "-c", "8", "-b", "-n", "2"]), 0)

        β::τμήμα("λάθος χρήσεις γυρίζουν 2")
        β::ίσο("άγνωστη επιλογή", εκ::ξεκίνα("el", ["--δεν-υπάρχει"]), 2)
        β::ίσο("επιλογή χωρίς τιμή", εκ::ξεκίνα("el", ["-r"]), 2)
        β::ίσο("άγνωστο σχήμα", εκ::ξεκίνα("el", ["-p", "spaceship", "-b"]), 2)
        β::ίσο("άγνωστο θέμα", εκ::ξεκίνα("el", ["-t", "neon", "-b"]), 2)
        β::ίσο("άγνωστη γλώσσα", εκ::ξεκίνα("el", ["-L", "xx", "-b"]), 2)
        β::ίσο("κανόνας χωρίς κάθετο", εκ::ξεκίνα("el", ["-R", "B3S23", "-b"]), 2)
        β::ίσο("κανόνας με 9", εκ::ξεκίνα("el", ["-R", "B9/S23", "-b"]), 2)
        β::ίσο("κανόνας χωρίς B/S", εκ::ξεκίνα("el", ["-R", "3/23", "-b"]), 2)
        β::ίσο("αριθμός που δεν είναι αριθμός", εκ::ξεκίνα("el", ["-r", "δέκα", "-b"]), 2)

        β::τμήμα("ο κόσμος κόβεται στην οθόνη")
        // Χωρίς τερματικό το >>? απαντά (24, 80), άρα ο μεγαλύτερος κόσμος
        // είναι 21×40. Ζητάμε 200×200 και πρέπει να πάρουμε αυτόν, με το
        // μήνυμα που το λέει.
        β::ίσο("200×200 γίνεται δεκτό και κόβεται", εκ::ξεκίνα("el", ["-r", "200", "-c", "200", "-p", "glider", "-b", "-n", "2"]), 0)

        β::τμήμα("το τέλος αναγνωρίζεται και σε παρτίδα")
        // Το blinker ταλαντώνεται: πρέπει να σταματήσει μόνο του πολύ πριν
        // από το όριο των 1000 που βάζει η παρτίδα χωρίς -n.
        β::ίσο("blinker σταματά μόνο του", εκ::ξεκίνα("el", ["-p", "blinker", "-r", "10", "-c", "10", "-b"]), 0)
        β::ίσο("block σταματά μόνο του", εκ::ξεκίνα("el", ["-p", "block", "-r", "10", "-c", "10", "-b"]), 0)
        β::ίσο("diehard σβήνει μόνο του", εκ::ξεκίνα("el", ["-p", "diehard", "-r", "20", "-c", "40", "-b"]), 0)

        >> "  └────────────────────────────────────────────────" ¶
        <~ β::σύνοψη("εκκίνηση")
    }
}
