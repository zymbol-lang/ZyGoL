Το Παιχνίδι της Ζωής του Conway
  -r, --rows N       ύψος του κόσμου
  -c, --cols N       πλάτος του κόσμου
  -p, --pattern NAME ξεκίνα από γνωστό σχήμα, στο κέντρο
  -R, --rule RULE    B3/S23 (προεπιλογή), B36/S23, B2/S, ...
  -t, --theme NAME   εικονίδια (προεπιλογή), πλίνθοι, γράμματα
  -d, --delay MS     χιλιοστά του δευτερολέπτου ανά γενιά
  -s, --seed N       σπόρος για το τυχαίο
  -x, --random       γέμισε τον κόσμο στην τύχη
  -e, --edges        ο κόσμος έχει άκρες (αλλιώς είναι τόρος)
  -n, --turns N      σταμάτα μετά από N γενιές
  -b, --batch        τρέξε χωρίς οθόνη και ανάφερε
  -L, --lang CODE    el (προεπιλογή), es, en, hi
  -l, --list         δείξε σχήματα και θέματα
  -h, --help         αυτό το κείμενο
