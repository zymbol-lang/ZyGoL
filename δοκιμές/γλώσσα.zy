// ============================================================
// δοκιμές/γλώσσα.zy — η πύλη πληρότητας των γλωσσών.
//
// Περπατά τον κατάλογο κλειδιών σε κάθε γλώσσα και αναφέρει κάθε
// κλειδί που έπεσε στην ταυτοτική περίπτωση — που είναι ο ορισμός
// του «λείπει», αφού κάθε κλειδί έχει πρόθεμα περιοχής και δεν
// μπορεί να ισούται με τη μετάφρασή του (USERAPPI18N.md §10).
//
// Δοκιμάζει και τις σύνθετες φράσεις, γιατί ένας στατικός πίνακας
// μπορεί μόνο να λείπει ενώ μια σύνθετη φράση μπορεί να είναι ΛΑΘΟΣ:
// σπασμένος πληθυντικός, κλαδί που δεν καλύφθηκε. Κάθε κλαδί
// καλείται σε κάθε γλώσσα.
//
// Και περπατά ΟΛΟΚΛΗΡΗ την περιστροφή των γλωσσών, γυρίζοντας στην
// πρώτη — αυτός ο έλεγχος είναι που πιάνει την παγίδα του §7.
// ============================================================

# .δοκιμές_γλώσσα {

    <# ../γλώσσα/διανομέας => γ
    <# ../πρότυπο/τερματικό => τ
    <# ./βεβαίωση => β

    #> { τρέξε }



    // σιωπή = #1: τυπώνει μόνο ό,τι απέτυχε. Επιστρέφει το πλήθος
    // των αποτυχιών, που είναι και ο κωδικός εξόδου του δρομέα.
    τρέξε(σιωπή) {
        β::ξεκίνα_σουίτα("γλώσσα", σιωπή)
        φωνή = !σιωπή

        β::τμήμα("== πληρότητα ==")
        κλειδιά = γ::κλειδιά()
        λείπουν_όλα = 0

        @ κωδικός:γ::γλώσσες() {
            γ::όρισε(κωδικός)
            λείπουν = 0
            @ κλειδί:κλειδιά {
                ? (γ::κείμενο(κλειδί)) == κλειδί {
                    >> "      ΛΕΙΠΕΙ  " κωδικός "  " κλειδί ¶
                    λείπουν += 1
                }
            }
            λείπουν_όλα += λείπουν
            γ::όρισε("el")
            ? φωνή { >> "  [" κωδικός "] " τ::αριστερή_στοίχιση(γ::όνομα_γλώσσας(κωδικός), 12) " " (κλειδιά$# - λείπουν) "/" κλειδιά$# ¶ }
        }
        β::ίσο("καμία μετάφραση δεν λείπει", λείπουν_όλα, 0)

        β::τμήμα("== τα ονόματα των γλωσσών γράφονται στην ίδια τη γλώσσα ==")
        // Δηλαδή: το όνομα δεν αλλάζει όταν αλλάζει η ενεργή γλώσσα.
        αναφορά = ""
        @ ενεργή:γ::γλώσσες() {
            γ::όρισε(ενεργή)
            γραμμή = ""
            @ άλλη:γ::γλώσσες() { γραμμή = γραμμή " " γ::όνομα_γλώσσας(άλλη) }
            ? αναφορά == "" { αναφορά = γραμμή }
            β::ίσο("με ενεργή " ενεργή " τα ονόματα δεν αλλάζουν", γραμμή, αναφορά)
        }
        γ::όρισε("el")

        β::τμήμα("== σύνθετες φράσεις, κάθε κλαδί σε κάθε γλώσσα ==")
        @ κωδικός:γ::γλώσσες() {
            γ::όρισε(κωδικός)
            ? φωνή { >> "  [" κωδικός "]" ¶ }
            ? φωνή { >> "    πληθυσμός 0/1/2 : " γ::φράση_πληθυσμού(0) " · " γ::φράση_πληθυσμού(1) " · " γ::φράση_πληθυσμού(2) ¶ }
            ? φωνή { >> "    εξαφάνιση       : " γ::φράση_τέλους("εξαφάνιση", 41, 0) ¶ }
            ? φωνή { >> "    ακίνητο         : " γ::φράση_τέλους("ακίνητο", 12, 1) ¶ }
            ? φωνή { >> "    ταλάντωση       : " γ::φράση_τέλους("ταλάντωση", 7, 15) ¶ }
            ? φωνή { >> "    όριο            : " γ::φράση_τέλους("όριο", 100, 0) ¶ }
            ? φωνή { >> "    χρήστης         : " γ::φράση_τέλους("χρήστης", 3, 0) ¶ }
            ? φωνή { >> "    κόσμος τόρος    : " γ::φράση_κόσμου(21, 40, #1) ¶ }
            ? φωνή { >> "    κόσμος φραγμένος: " γ::φράση_κόσμου(21, 40, #0) ¶ }
            ? φωνή { >> "    ρυθμός          : " γ::φράση_ρυθμού(120) ¶ }
        }
        γ::όρισε("el")

        β::τμήμα("== τα ψηφία ακολουθούν τη γλώσσα ==")
        // Ο διακόπτης γραφής ψηφίων είναι καθολικός στη διεργασία και τον
        // βάζει ο διανομέας. Κανένα σημείο κλήσης εδώ δεν ξέρει τίποτα.
        έτος = 2026
        @ κωδικός:γ::γλώσσες() {
            γ::όρισε(κωδικός)
            // έτος είναι ΑΡΙΘΜΟΣ. Το ίδιο γραμμένο ως "2026" μέσα στο
            // κείμενο θα έμενε ASCII: ο τρόπος γραφής αφορά την εκτύπωση
            // αριθμών, όχι τα γράμματα ενός literal.
            ? φωνή { >> "  [" κωδικός "] " έτος " · " γ::φράση_πληθυσμού(361) " · " γ::φράση_πληθυσμού(1) ¶ }
        }
        γ::όρισε("el")

        β::τμήμα("== η περιστροφή γυρίζει στην αρχή ==")
        γλ = γ::γλώσσες()
        γ::όρισε(γλ[1])
        πρώτη = γ::τρέχουσα()
        @ κωδικός:γλ { γ::όρισε(κωδικός) }
        γ::όρισε(γλ[1])
        β::ίσο("η περιστροφή γυρίζει στην πρώτη γλώσσα", γ::τρέχουσα(), πρώτη)

        // Οι σύνθετες φράσεις δεν επιτρέπεται να ξεφύγουν στο κλειδί: αν
        // μια γλώσσα ξεχάσει ένα κλαδί, η φράση γυρίζει την αιτία αυτούσια.
        @ κωδικός:γ::γλώσσες() {
            γ::όρισε(κωδικός)
            @ αιτία:["εξαφάνιση", "ακίνητο", "ταλάντωση", "όριο", "χρήστης"] {
                β::αληθές("[" κωδικός "] η φράση «" αιτία "» δεν είναι το κλειδί", (γ::φράση_τέλους(αιτία, 1, 2)) <> αιτία)
            }
            β::αληθές("[" κωδικός "] ενικός και πληθυντικός διαφέρουν", (γ::φράση_πληθυσμού(1)) <> γ::φράση_πληθυσμού(2))
            β::αληθές("[" κωδικός "] τόρος και φραγμένος διαφέρουν", (γ::φράση_κόσμου(3, 4, #1)) <> γ::φράση_κόσμου(3, 4, #0))
        }
        γ::όρισε("el")

        <~ β::σύνοψη("γλώσσα")
    }
}
