// ============================================================
// πυρήνας/κόσμος.zy — ο κόσμος: το πλέγμα, ο κανόνας, μία γενιά.
//
// Το πλέγμα είναι πίνακας πινάκων από Int, με βάση το 1, και κάθε
// κύτταρο είναι 0 ή 1. Τίποτα εδώ δεν ζωγραφίζει, δεν διαβάζει
// πλήκτρο και δεν ξέρει τι είναι τερματικό: αυτό είναι το μέρος του
// προγράμματος που μια δοκιμή τρέχει χωρίς οθόνη.
//
// Όλα είναι καθαρές συναρτήσεις πάνω στο πλέγμα — ένα πλέγμα μπαίνει,
// ένα καινούργιο βγαίνει, και τίποτα δεν κρατιέται ως κατάσταση του
// module. Είναι επιλογή, και όχι η φθηνότερη: αν ο κόσμος ζούσε μέσα
// στο module θα έκρυβε το κόστος του να περνάς έναν σύνθετο τύπο από
// χέρι σε χέρι, που είναι ακριβώς αυτό που μετράει το μέτρηση/.
//
// EN: πυρήνας/κόσμος.zy — the world: grid, rule, one generation.
// Pure functions over the grid; no module state, deliberately, so
// μέτρηση/ can measure what passing an aggregate costs.
// ============================================================

# .πυρήνας_κόσμος {

    #> { νέος, βήμα, πληθυσμός, κανόνας, τυχαίος, ίσοι, διάγνωση, θύμησε, ΜΝΗΜΗ }

    // Οι οκτώ γείτονες ενός κυττάρου, ως μετατοπίσεις γραμμής και
    // στήλης. Γραμμένοι ως δύο πίνακες αντί για διπλό βρόχο -1..1
    // επίτηδες: ο βρόχος είναι σωστός και ο αναλυτής προειδοποιεί
    // ούτως ή άλλως (HALLAZGOS.md, GAP-GOL-004), και ο πίνακας είναι
    // και πιο γρήγορος — δεν παράγει ποτέ το κεντρικό κύτταρο που θα
    // έπρεπε να προσπεράσει.
    ΔΓ := [-1, -1, -1,  0,  0,  1,  1,  1]
    ΔΣ := [-1,  0,  1, -1,  1, -1,  0,  1]

    // Πόσες παλιές γενιές κρατάμε για να αναγνωρίσουμε κύκλο. 16
    // επειδή το pentadecathlon έχει περίοδο 15 και είναι ο μακρύτερος
    // κύκλος που συναντά κανείς χωρίς να τον ψάχνει.
    ΜΝΗΜΗ := 16

    _άδεια() { <~ [0, 0, 0, 0, 0, 0, 0, 0, 0] }

    // ── Ο κανόνας ───────────────────────────────────────────
    //
    // Η Ζωή είναι B3/S23: νεκρό κύτταρο με ακριβώς 3 γείτονες
    // γεννιέται, ζωντανό με 2 ή 3 επιβιώνει. Υπάρχουν κι άλλοι
    // κανόνες γραμμένοι το ίδιο — HighLife B36/S23, Seeds B2/S — γι'
    // αυτό ο κανόνας διαβάζεται, δεν είναι καρφωμένος.
    //
    // Επιστρέφει (κλειδί_σφάλματος, γεννήσεις, επιβιώσεις). Το κλειδί
    // είναι "" όταν όλα πήγαν καλά, αλλιώς κλειδί του καταλόγου που ο
    // καλών δίνει στον διανομέα: ο πυρήνας δεν γράφει ποτέ κείμενο
    // που θα διαβάσει άνθρωπος.
    //
    // Γυρίζει πλειάδα αντί να σηκώσει σφάλμα επειδή η Zymbol δεν έχει
    // τρόπο να ΦΤΙΑΞΕΙ σφάλμα (HALLAZGOS.md, GAP-GOL-003).

    κανόνας(κείμενο) {
        μέρη = κείμενο $/ '/'
        ? μέρη$# <> 2 { <~ ("σφάλμα.κανόνας_μορφή", [], []) }

        γέννηση = _άδεια()
        επιβίωση = _άδεια()
        δείκτης = 0

        @ τμήμα:μέρη {
            δείκτης += 1
            ? τμήμα$# < 1 { <~ ("σφάλμα.κανόνας_κενό", [], []) }
            πρώτο = #1
            @ χ:τμήμα {
                ? πρώτο {
                    πρώτο = #0
                    ? χ <> 'B' && χ <> 'b' && χ <> 'S' && χ <> 's' {
                        <~ ("σφάλμα.κανόνας_γράμμα", [], [])
                    }
                    @>
                }
                ψηφίο = ##!χ - ##!'0'
                ? ψηφίο < 0 || ψηφίο > 8 {
                    <~ ("σφάλμα.κανόνας_ψηφίο", [], [])
                }
                ? δείκτης == 1 { γέννηση[ψηφίο + 1]$~ 1 }
                _ { επιβίωση[ψηφίο + 1]$~ 1 }
            }
        }
        <~ ("", γέννηση, επιβίωση)
    }

    // ── Το πλέγμα ───────────────────────────────────────────

    νέος(γραμμές, στήλες) {
        πλέγμα = []
        @ γραμμές {
            σειρά = []
            @ στήλες { σειρά$+ 0 }
            πλέγμα$+ σειρά
        }
        <~ πλέγμα
    }

    πληθυσμός(πλέγμα) {
        ζωντανά = 0
        @ σειρά:πλέγμα {
            @ κύτταρο:σειρά { ζωντανά += κύτταρο }
        }
        <~ ζωντανά
    }

    ίσοι(α, β) {
        ? α$# <> β$# { <~ #0 }
        δείκτης = 0
        @ σειρά:α {
            δείκτης += 1
            ? σειρά <> β[δείκτης] { <~ #0 }
        }
        <~ #1
    }

    // ── Μία γενιά ───────────────────────────────────────────
    //
    // τοροειδές = #1 τυλίγει τις άκρες (το επίπεδο είναι τόρος)·
    // #0 θεωρεί νεκρό ό,τι πέφτει έξω από το πλέγμα.

    _γείτονες(πλέγμα, γ, σ, γραμμές, στήλες, τοροειδές) {
        ν = 0
        θ = 0
        @ δγ:ΔΓ {
            θ += 1
            ργ = γ + δγ
            ρσ = σ + ΔΣ[θ]
            ? τοροειδές {
                ργ = ((ργ - 1 + γραμμές) % γραμμές) + 1
                ρσ = ((ρσ - 1 + στήλες) % στήλες) + 1
            } _ {
                ? ργ < 1 || ργ > γραμμές || ρσ < 1 || ρσ > στήλες { @> }
            }
            ν += πλέγμα[ργ>ρσ]
        }
        <~ ν
    }

    βήμα(πλέγμα, γέννηση, επιβίωση, τοροειδές) {
        γραμμές = πλέγμα$#
        ? γραμμές == 0 { <~ πλέγμα }
        στήλες = πλέγμα[1]$#
        ? στήλες == 0 { <~ πλέγμα }

        επόμενο = []
        γ = 0
        @ σειρά:πλέγμα {
            γ += 1
            νέα_σειρά = []
            σ = 0
            @ κύτταρο:σειρά {
                σ += 1
                ν = _γείτονες(πλέγμα, γ, σ, γραμμές, στήλες, τοροειδές)
                ? κύτταρο == 1 { νέα_σειρά$+ επιβίωση[ν + 1] }
                _ { νέα_σειρά$+ γέννηση[ν + 1] }
            }
            επόμενο$+ νέα_σειρά
        }
        <~ επόμενο
    }

    // ── Πότε τελείωσε ───────────────────────────────────────
    //
    // Η Ζωή δεν έχει τέρμα: κάθε αρχή ή σβήνει, ή κοκαλώνει, ή
    // μπαίνει σε κύκλο, ή μεγαλώνει για πάντα. Οι τρεις πρώτες
    // περιπτώσεις αναγνωρίζονται, κι εκεί το πρόγραμμα σταματά αντί
    // να ζωγραφίζει το ίδιο καρέ ώσπου να το κλείσει κάποιος.
    //
    // Επιστρέφει (αιτία, περίοδος):
    //   ("εξαφάνιση", 0)  δεν έμεινε τίποτα ζωντανό
    //   ("ακίνητο", 1)    ίδιο με την προηγούμενη γενιά
    //   ("ταλάντωση", ν)  ίδιο με τη γενιά ν πίσω, ν >= 2
    //   ("", 0)           συνεχίζει
    //
    // Ο πληθυσμός συγκρίνεται πρώτος: είναι ένας ακέραιος, και όταν
    // διαφέρει — που είναι η συνηθισμένη περίπτωση — δεν χρειάζεται
    // να κοιταχτεί ούτε ένα κύτταρο.

    διάγνωση(πλέγμα, ιστορικό) {
        π = πληθυσμός(πλέγμα)
        ? π == 0 { <~ ("εξαφάνιση", 0) }

        απόσταση = 0
        @ παλιό:ιστορικό {
            απόσταση += 1
            ? πληθυσμός(παλιό) == π {
                ? ίσοι(πλέγμα, παλιό) {
                    ? απόσταση == 1 { <~ ("ακίνητο", 1) }
                    <~ ("ταλάντωση", απόσταση)
                }
            }
        }
        <~ ("", 0)
    }

    // Πιο πρόσφατο μπροστά, και κόβεται στο ΜΝΗΜΗ.
    θύμησε(ιστορικό, πλέγμα) {
        νέο = [πλέγμα]
        @ παλιό:ιστορικό {
            ? νέο$# >= ΜΝΗΜΗ { <~ νέο }
            νέο$+ παλιό
        }
        <~ νέο
    }

    // ── Τυχαία αρχή ─────────────────────────────────────────
    //
    // Γραμμική γεννήτρια με σπόρο από τον καλούντα, ώστε μια παρτίδα
    // να ξαναβγαίνει ίδια από τον σπόρο της. Η πυκνότητα είναι επί
    // τοις εκατό.

    τυχαίος(γραμμές, στήλες, πυκνότητα, σπόρος) {
        κ = σπόρος % 2147483647
        ? κ <= 0 { κ += 2147483646 }
        πλέγμα = []
        @ γραμμές {
            σειρά = []
            @ στήλες {
                κ = (κ * 48271) % 2147483647
                ? (κ % 100) < πυκνότητα { σειρά$+ 1 } _ { σειρά$+ 0 }
            }
            πλέγμα$+ σειρά
        }
        <~ (πλέγμα, κ)
    }
}
