// ============================================================
// παιχνίδι.zy — ο βρόχος: σύνταξη, εκτέλεση, τέλος.
//
// Μία οθόνη κάνει και τις δύο δουλειές, γιατί είναι η ίδια δουλειά:
// ο κόσμος είναι πάντα εκεί, ο δρομέας είναι πάντα εκεί, και το ↵
// αποφασίζει αν προχωρούν οι γενιές. Η Ζωή δεν έχει ξεχωριστή φάση
// στησίματος — ένα σχήμα μπορεί να πειραχτεί ενώ τρέχει, κι αυτό
// αξίζει περισσότερο από έναν διακόπτη τρόπου.
//
// Η Ζωή δεν έχει ούτε τέρμα, και γι' αυτό υπάρχει ο τρίτος τρόπος:
// όταν ο κόσμος σβήσει, παγώσει ή μπει σε κύκλο, το πρόγραμμα
// σταματά και το λέει, αντί να ζωγραφίζει το ίδιο καρέ ώσπου να το
// κλείσει κάποιος. Το ίδιο κάνει και το όριο γύρων.
//
// EN: παιχνίδι.zy — the loop. One screen edits and runs; a third
// mode reports why it stopped, because Life does not end on its own.
// ============================================================

# παιχνίδι {

    <# ./πυρήνας/κόσμος => κ
    <# ./πυρήνας/σχήματα => σ
    <# ./εμφάνιση/όψη => ό
    <# ./γλώσσα/διανομέας => γ
    <# ./πρότυπο/τερματικό => τ

    #> { τρέξε }

    ΕΛΑΧΙΣΤΗ_ΚΑΘΥΣΤΕΡΗΣΗ := 10
    ΜΕΓΙΣΤΗ_ΚΑΘΥΣΤΕΡΗΣΗ  := 2000
    ΠΥΚΝΟΤΗΤΑ            := 28
    ESC                  := 0d27

    _όνομα_σχήματος(αναγνωριστικό) {
        ? αναγνωριστικό == "" { <~ "" }
        ? αναγνωριστικό == "τυχαίο" { <~ γ::κείμενο("πλήκτρο.τυχαίο") }
        <~ γ::κείμενο("σχήμα." αναγνωριστικό)
    }

    _γραμμές_σχημάτων() {
        έξω = []
        @ όνομα:σ::ονόματα() {
            κατ = γ::κείμενο("κατηγορία." σ::κατηγορία(όνομα))
            έξω$+ (τ::αριστερή_στοίχιση(γ::κείμενο("σχήμα." όνομα), 22) " " κατ)
        }
        <~ έξω
    }

    _γραμμές_γλωσσών() {
        έξω = []
        @ κωδικός:γ::γλώσσες() {
            έξω$+ (τ::αριστερή_στοίχιση(κωδικός, 4) " " γ::όνομα_γλώσσας(κωδικός))
        }
        <~ έξω
    }

    _ζωγράφισε(π, θ, γενιά, όριο, όνομα_κανόνα, τοροειδές, καθυστέρηση,
               κλειδί_τρόπου, σχήμα, ορατές_γ, ορατές_σ, ύψος, πλάτος) {
        ό::κατάσταση(γενιά, κ::πληθυσμός(π), π$#, π[1]$#, τοροειδές,
                     όνομα_κανόνα, καθυστέρηση, κλειδί_τρόπου,
                     _όνομα_σχήματος(σχήμα), όριο, πλάτος)
        ό::πλέγμα(π, θ, ορατές_γ, ορατές_σ)
        ό::βοήθεια(ύψος, πλάτος)
    }

    // Η φράση του τέλους, στη θέση της βοήθειας, ώσπου να πατηθεί
    // κάτι. Είναι σύνθετη φράση της γλώσσας και όχι κείμενο
    // φτιαγμένο εδώ με κόλληση (USERAPPI18N.md §4).
    _γράψε_τέλος(αιτία, γενιά, περίοδος, ύψος, πλάτος) {
        φράση = γ::φράση_τέλους(αιτία, γενιά, περίοδος)
        γραμμή = "■ " φράση "   ·   ↵ " γ::κείμενο("πλήκτρο.εκκίνηση") "   q " γ::κείμενο("πλήκτρο.έξοδος")
        ? τ::πλάτος(γραμμή) > πλάτος { γραμμή = τ::κόψε(γραμμή, πλάτος) }
        >>~ (ύψος, 1, 1, 208, 0) > τ::αριστερή_στοίχιση(γραμμή, πλάτος)
    }

    τρέξε(πλέγμα, όνομα_θέματος, γέννηση, επιβίωση, όνομα_κανόνα, τοροειδές,
          καθυστέρηση, σπόρος, τρέχει_στην_αρχή, αναγνωριστικό_σχήματος, όριο_γύρων) {

        (ύψος, πλάτος) = >>?
        (ορατές_γ, ορατές_σ) = ό::χωράει(ύψος, πλάτος)

        π = πλέγμα
        γραμμές = π$#
        στήλες = π[1]$#

        (_μ, θ) = ό::θέμα(όνομα_θέματος)
        όνομα_θ = όνομα_θέματος

        γ_δρομέα = (γραμμές + 1) / 2
        σ_δρομέα = (στήλες + 1) / 2
        γενιά = 0
        τρέχει = τρέχει_στην_αρχή
        ρυθμός = καθυστέρηση
        τρέχων_σπόρος = σπόρος
        σχήμα = αναγνωριστικό_σχήματος
        ιστορικό = []
        αιτία = ""
        περίοδος = 0
        ονόματα_συντόμων = σ.ΣΥΝΤΟΜΑ

        >>| {
            >>!
            _ζωγράφισε(π, θ, γενιά, όριο_γύρων, όνομα_κανόνα, τοροειδές, ρυθμός,
                       "τρόπος.σύνταξη", σχήμα, ορατές_γ, ορατές_σ, ύψος, πλάτος)
            ό::δρομέας(θ, γ_δρομέα, σ_δρομέα, π[γ_δρομέα>σ_δρομέα] == 1)

            @ {
                // Μπλοκάρει όσο συντάσσεις, ρωτά όσο τρέχει: ένας
                // συντάκτης που καίει επεξεργαστή περιμένοντας πλήκτρο
                // είναι σφάλμα, κι ένας κόσμος που μπλοκάρει σε πλήκτρο
                // δεν προχωρά ποτέ.
                πλ = '\0'
                ? τρέχει { <<|? πλ } _ { <<| πλ }

                ? πλ == 'q' || πλ == 'Q' { @! }

                ανανέωση = #0

                ? πλ == '↑' { γ_δρομέα -= 1
                              ? γ_δρομέα < 1 { γ_δρομέα = γραμμές }
                              ανανέωση = #1 }
                ? πλ == '↓' { γ_δρομέα += 1
                              ? γ_δρομέα > γραμμές { γ_δρομέα = 1 }
                              ανανέωση = #1 }
                ? πλ == '←' { σ_δρομέα -= 1
                              ? σ_δρομέα < 1 { σ_δρομέα = στήλες }
                              ανανέωση = #1 }
                ? πλ == '→' { σ_δρομέα += 1
                              ? σ_δρομέα > στήλες { σ_δρομέα = 1 }
                              ανανέωση = #1 }

                ? πλ == ' ' {
                    ? π[γ_δρομέα>σ_δρομέα] == 1 { π[γ_δρομέα>σ_δρομέα]$~ 0 }
                    _ { π[γ_δρομέα>σ_δρομέα]$~ 1 }
                    ιστορικό = []
                    αιτία = ""
                    ανανέωση = #1
                }

                // ↵ ξεκινά, σταματά, ή καθαρίζει το τέλος και
                // ξαναρχίζει τη μέτρηση.
                ? πλ == '\n' {
                    ? αιτία <> "" {
                        αιτία = ""
                        γενιά = 0
                        ιστορικό = []
                        τρέχει = #0
                    } _ { τρέχει = !τρέχει }
                    ανανέωση = #1
                }

                ? πλ == 'n' || πλ == 'N' {
                    ιστορικό = κ::θύμησε(ιστορικό, π)
                    π = κ::βήμα(π, γέννηση, επιβίωση, τοροειδές)
                    γενιά += 1
                    (αιτία, περίοδος) = κ::διάγνωση(π, ιστορικό)
                    ανανέωση = #1
                }

                ? πλ == 'c' || πλ == 'C' {
                    π = κ::νέος(γραμμές, στήλες)
                    γενιά = 0
                    σχήμα = ""
                    ιστορικό = []
                    αιτία = ""
                    τρέχει = #0
                    ανανέωση = #1
                }

                ? πλ == 'r' || πλ == 'R' {
                    (π, τρέχων_σπόρος) = κ::τυχαίος(γραμμές, στήλες, ΠΥΚΝΟΤΗΤΑ, τρέχων_σπόρος)
                    γενιά = 0
                    σχήμα = "τυχαίο"
                    ιστορικό = []
                    αιτία = ""
                    ανανέωση = #1
                }

                ? πλ == 't' || πλ == 'T' {
                    όνομα_θ = ό::επόμενο_θέμα(όνομα_θ)
                    (_μ2, θ) = ό::θέμα(όνομα_θ)
                    ανανέωση = #1
                }

                // ── Ο κατάλογος σχημάτων ────────────────────
                ? πλ == 'p' || πλ == 'P' {
                    ονόματα = σ::ονόματα()
                    θέση = 1
                    διάλεξε = #0
                    @ {
                        ό::μενού("μενού.σχήματα", _γραμμές_σχημάτων(), θέση, ύψος, πλάτος)
                        <<| πλ2
                        ? πλ2 == '↑' { θέση -= 1
                                       ? θέση < 1 { θέση = ονόματα$# } }
                        ? πλ2 == '↓' { θέση += 1
                                       ? θέση > ονόματα$# { θέση = 1 } }
                        ? πλ2 == '\n' { διάλεξε = #1
                                        @! }
                        ? πλ2 == ESC || πλ2 == 'q' || πλ2 == 'Q' { @! }
                    }
                    ? διάλεξε {
                        (μήνυμα, κελιά) = σ::πάρε(ονόματα[θέση])
                        ? μήνυμα == "" {
                            π = σ::τοποθέτησε(π, κελιά, γ_δρομέα, σ_δρομέα)
                            σχήμα = ονόματα[θέση]
                            ιστορικό = []
                            αιτία = ""
                        }
                    }
                    >>!
                    ανανέωση = #1
                }

                // ── Ο κατάλογος γλωσσών ─────────────────────
                //
                // Μέσα στο παιχνίδι, σε κάθε στιγμή. Ο χρήστης που
                // δεν διαβάζει την τρέχουσα γλώσσα είναι ακριβώς
                // αυτός που δεν μπορεί να βρει το ξόρκι εκκίνησης
                // για τη δική του (USERAPPI18N.md §7).
                ? πλ == 'l' || πλ == 'L' {
                    κωδικοί = γ::γλώσσες()
                    θέση = 1
                    δ = 0
                    @ κωδικός:κωδικοί {
                        δ += 1
                        ? κωδικός == γ::τρέχουσα() { θέση = δ }
                    }
                    @ {
                        ό::μενού("μενού.γλώσσες", _γραμμές_γλωσσών(), θέση, ύψος, πλάτος)
                        <<| πλ3
                        ? πλ3 == '↑' { θέση -= 1
                                       ? θέση < 1 { θέση = κωδικοί$# } }
                        ? πλ3 == '↓' { θέση += 1
                                       ? θέση > κωδικοί$# { θέση = 1 } }
                        ? πλ3 == '\n' { γ::όρισε(κωδικοί[θέση])
                                        @! }
                        ? πλ3 == ESC || πλ3 == 'q' || πλ3 == 'Q' { @! }
                    }
                    // Ξαναζωγραφίζουμε ΤΑ ΠΑΝΤΑ: η νέα γλώσσα έχει
                    // άλλα πλάτη, κι ένα μερικό ξαναγράψιμο αφήνει
                    // κομμάτια της προηγούμενης στην οθόνη.
                    >>!
                    ανανέωση = #1
                }

                ψηφίο = ##!πλ - ##!'0'
                ? ψηφίο >= 1 && ψηφίο <= ονόματα_συντόμων$# {
                    όνομα = ονόματα_συντόμων[ψηφίο]
                    (μήνυμα, κελιά) = σ::πάρε(όνομα)
                    ? μήνυμα == "" {
                        π = σ::τοποθέτησε(π, κελιά, γ_δρομέα, σ_δρομέα)
                        σχήμα = όνομα
                        ιστορικό = []
                        αιτία = ""
                        ανανέωση = #1
                    }
                }

                ? πλ == '+' || πλ == '=' {
                    ρυθμός = ρυθμός / 2
                    ? ρυθμός < ΕΛΑΧΙΣΤΗ_ΚΑΘΥΣΤΕΡΗΣΗ { ρυθμός = ΕΛΑΧΙΣΤΗ_ΚΑΘΥΣΤΕΡΗΣΗ }
                    ανανέωση = #1
                }
                ? πλ == '-' || πλ == '_' {
                    ρυθμός = ρυθμός * 2
                    ? ρυθμός > ΜΕΓΙΣΤΗ_ΚΑΘΥΣΤΕΡΗΣΗ { ρυθμός = ΜΕΓΙΣΤΗ_ΚΑΘΥΣΤΕΡΗΣΗ }
                    ανανέωση = #1
                }

                // ── Μία γενιά, κι ο έλεγχος του τέλους ──────
                ? τρέχει && αιτία == "" {
                    ιστορικό = κ::θύμησε(ιστορικό, π)
                    π = κ::βήμα(π, γέννηση, επιβίωση, τοροειδές)
                    γενιά += 1
                    (αιτία, περίοδος) = κ::διάγνωση(π, ιστορικό)
                    ? αιτία == "" && όριο_γύρων > 0 && γενιά >= όριο_γύρων {
                        αιτία = "όριο"
                        περίοδος = 0
                    }
                    ? αιτία <> "" { τρέχει = #0 }
                    ανανέωση = #1
                }

                ? ανανέωση {
                    κλειδί_τρόπου = "τρόπος.σύνταξη"
                    ? τρέχει { κλειδί_τρόπου = "τρόπος.εκτέλεση" }
                    ? αιτία <> "" { κλειδί_τρόπου = "τρόπος.τέλος" }
                    _ζωγράφισε(π, θ, γενιά, όριο_γύρων, όνομα_κανόνα, τοροειδές, ρυθμός,
                               κλειδί_τρόπου, σχήμα, ορατές_γ, ορατές_σ, ύψος, πλάτος)
                    ? αιτία <> "" { _γράψε_τέλος(αιτία, γενιά, περίοδος, ύψος, πλάτος) }
                    ? !τρέχει && αιτία == "" { ό::δρομέας(θ, γ_δρομέα, σ_δρομέα, π[γ_δρομέα>σ_δρομέα] == 1) }
                }

                ? τρέχει { @~ ρυθμός }
            }
        }
        τελική = αιτία
        ? τελική == "" { τελική = "χρήστης" }
        <~ (τελική, γενιά, περίοδος)
    }
}
