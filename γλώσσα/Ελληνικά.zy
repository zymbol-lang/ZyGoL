// ============================================================
// γλώσσα/Ελληνικά.zy — ελληνικά (el) — Η ΒΑΣΗ
//
// Συμβόλαιο: κείμενο · φράση_πληθυσμού · φράση_τέλους ·
//            φράση_κόσμου · φράση_ρυθμού
//
// Τα κλειδιά είναι ελληνικά και αυτός ο πίνακας είναι η βάση. ΔΕΝ
// είναι ταυτοτική συνάρτηση και δεν επιτρέπεται να γίνει: το κλειδί
// "τέλος.ακίνητο" είναι μια έννοια, και εδώ ξεδιπλώνεται στη φράση
// που θα διαβάσει ο άνθρωπος (USERAPPI18N.md §3).
// ============================================================

# .γλώσσα_Ελληνικά {

    #> { κείμενο, φράση_πληθυσμού, φράση_τέλους, φράση_κόσμου, φράση_ρυθμού }

    κείμενο(κλειδί) {
        <~ ?? κλειδί {
            "γλώσσα.όνομα"            => "Ελληνικά"

            "κατάσταση.γενιά"         => "γενιά"
            "κατάσταση.πληθυσμός"     => "ζωντανά"
            "κατάσταση.κανόνας"       => "κανόνας"
            "κατάσταση.ρυθμός"        => "ρυθμός"
            "κατάσταση.σχήμα"         => "σχήμα"
            "κατάσταση.τίποτα"        => "—"

            "τρόπος.σύνταξη"          => "ΣΥΝΤΑΞΗ"
            "τρόπος.εκτέλεση"         => "ΤΡΕΧΕΙ "
            "τρόπος.τέλος"            => "ΤΕΛΟΣ  "

            "πλήκτρο.κίνηση"          => "κίνηση"
            "πλήκτρο.εναλλαγή"        => "άλλαξε"
            "πλήκτρο.εκκίνηση"        => "τρέξε/στοπ"
            "πλήκτρο.βήμα"            => "βήμα"
            "πλήκτρο.καθάρισμα"       => "σβήσε"
            "πλήκτρο.τυχαίο"          => "τυχαίο"
            "πλήκτρο.σχήμα"           => "σχήμα"
            "πλήκτρο.θέμα"            => "θέμα"
            "πλήκτρο.ταχύτητα"        => "ταχύτητα"
            "πλήκτρο.γλώσσα"          => "γλώσσα"
            "πλήκτρο.έξοδος"          => "έξοδος"
            "πλήκτρο.επιλογή"         => "διάλεξε"
            "πλήκτρο.άκυρο"           => "άκυρο"

            "τέλος.εξαφάνιση"         => "όλα πέθαναν"
            "τέλος.ακίνητο"           => "ο κόσμος πάγωσε"
            "τέλος.ταλάντωση"         => "ο κόσμος ταλαντώνεται"
            "τέλος.όριο"              => "τέλος των γύρων"
            "τέλος.χρήστης"           => "σταμάτησες"

            "μενού.σχήματα"           => "Διάλεξε σχήμα"
            "μενού.γλώσσες"           => "Διάλεξε γλώσσα"

            "κατηγορία.ακίνητο"       => "ακίνητο"
            "κατηγορία.ταλαντωτής"    => "ταλαντωτής"
            "κατηγορία.διαστημόπλοιο" => "διαστημόπλοιο"
            "κατηγορία.μαθουσάλας"    => "μαθουσάλας"
            "κατηγορία.κανόνι"        => "κανόνι"

            "σχήμα.block"             => "τετράγωνο"
            "σχήμα.beehive"           => "κυψέλη"
            "σχήμα.loaf"              => "καρβέλι"
            "σχήμα.boat"              => "βάρκα"
            "σχήμα.tub"               => "σκάφη"
            "σχήμα.blinker"           => "αναβοσβήστης"
            "σχήμα.toad"              => "φρύνος"
            "σχήμα.beacon"            => "φάρος"
            "σχήμα.pulsar"            => "παλμητής"
            "σχήμα.pentadecathlon"    => "πεντάδεκάθλο"
            "σχήμα.glider"            => "ολισθητής"
            "σχήμα.lwss"              => "ελαφρύ σκάφος"
            "σχήμα.mwss"              => "μεσαίο σκάφος"
            "σχήμα.hwss"              => "βαρύ σκάφος"
            "σχήμα.rpentomino"        => "ρο-πεντόμινο"
            "σχήμα.diehard"           => "σκληρό καρύδι"
            "σχήμα.acorn"             => "βελανίδι"
            "σχήμα.gosper"            => "κανόνι του Gosper"

            "θέμα.emoji"              => "εικονίδια"
            "θέμα.block"              => "πλίνθοι"
            "θέμα.ascii"              => "γράμματα"

            "σφάλμα.κανόνας_μορφή"    => "ο κανόνας γράφεται B<αριθμοί>/S<αριθμοί>, π.χ. B3/S23"
            "σφάλμα.κανόνας_κενό"     => "το μισό του κανόνα είναι κενό"
            "σφάλμα.κανόνας_γράμμα"   => "κάθε μισό του κανόνα αρχίζει με B ή S"
            "σφάλμα.κανόνας_ψηφίο"    => "το πλήθος γειτόνων είναι ψηφίο από 0 ως 8"
            "σφάλμα.άγνωστο_σχήμα"    => "δεν υπάρχει τέτοιο σχήμα"
            "σφάλμα.άγνωστο_θέμα"     => "δεν υπάρχει τέτοιο θέμα"
            "σφάλμα.άγνωστη_γλώσσα"   => "δεν υπάρχει τέτοια γλώσσα"
            "σφάλμα.άγνωστη_επιλογή"  => "άγνωστη επιλογή"
            "σφάλμα.λείπει_τιμή"      => "η επιλογή θέλει τιμή"
            "σφάλμα.αριθμός"          => "εδώ χρειάζεται ακέραιος μη αρνητικός"
            "σφάλμα.μικρή_οθόνη"      => "η οθόνη είναι πολύ μικρή"

            "χρήση.τίτλος"            => "Το Παιχνίδι της Ζωής του Conway"
            "χρήση.γραμμές"           => "ύψος του κόσμου"
            "χρήση.στήλες"            => "πλάτος του κόσμου"
            "χρήση.σχήμα"             => "ξεκίνα από γνωστό σχήμα, στο κέντρο"
            "χρήση.κανόνας"           => "B3/S23 (προεπιλογή), B36/S23, B2/S, ..."
            "χρήση.θέμα"              => "εικονίδια (προεπιλογή), πλίνθοι, γράμματα"
            "χρήση.ρυθμός"            => "χιλιοστά του δευτερολέπτου ανά γενιά"
            "χρήση.σπόρος"            => "σπόρος για το τυχαίο"
            "χρήση.τυχαίο"            => "γέμισε τον κόσμο στην τύχη"
            "χρήση.φραγμένο"          => "ο κόσμος έχει άκρες (αλλιώς είναι τόρος)"
            "χρήση.τρέξε"             => "ξεκίνα τρέχοντας αντί για σύνταξη"
            "χρήση.γύροι"             => "σταμάτα μετά από N γενιές"
            "χρήση.γενιές"            => "τρέξε χωρίς οθόνη και ανάφερε"
            "χρήση.κάθε"              => "με --batch, ανάφερε κάθε K γενιές"
            "χρήση.τύπωσε"            => "με --batch, τύπωσε τον τελικό κόσμο"
            "χρήση.χρόνος"            => "με --batch, ανάφερε τη διάρκεια σε ms"
            "χρήση.γλώσσα"            => "el (προεπιλογή), es, en, hi"
            "χρήση.κατάλογος"         => "δείξε σχήματα και θέματα"
            "χρήση.βοήθεια"           => "αυτό το κείμενο"
            "χρήση.σχήματα"           => "Σχήματα"
            "χρήση.περιορίστηκε"      => "ο κόσμος περιορίστηκε στην οθόνη"

            _                         => κλειδί
        }
    }

    // Ουδέτερο: ένα ζωντανό, πολλά ζωντανά.
    φράση_πληθυσμού(ν) {
        // «{ν}» και όχι «1»: το ψηφίο πρέπει να περάσει από τον αριθμό,
    // αλλιώς ο ενικός μένει ASCII σε γλώσσα με δικά της ψηφία και
    // κανείς δεν το βλέπει στα ελληνικά. HALLAZGOS.md, IDEA-GOL-008.
    ? ν == 1 { <~ "{ν} ζωντανό" }
        <~ "{ν} ζωντανά"
    }

    φράση_τέλους(αιτία, γενιά, περίοδος) {
        ?? αιτία {
            "εξαφάνιση" => { <~ "όλα πέθαναν στη γενιά {γενιά}" }
            "ακίνητο"   => { <~ "ο κόσμος πάγωσε στη γενιά {γενιά}" }
            "ταλάντωση" => { <~ "ο κόσμος ταλαντώνεται με περίοδο {περίοδος}, από τη γενιά {γενιά}" }
            "όριο"      => { <~ "τέλος στη γενιά {γενιά}" }
            _           => { <~ "σταμάτησες στη γενιά {γενιά}" }
        }
    }

    φράση_κόσμου(γραμμές, στήλες, τοροειδές) {
        ? τοροειδές { <~ "{γραμμές}×{στήλες} τόρος" }
        <~ "{γραμμές}×{στήλες} φραγμένος"
    }

    φράση_ρυθμού(χιλιοστά) { <~ "{χιλιοστά} ms" }
}
