// ============================================================
// γλώσσα/हिन्दी.zy — हिन्दी (hi)
// Συμβόλαιο: κείμενο · φράση_πληθυσμού · φράση_τέλους ·
//            φράση_κόσμου · φράση_ρυθμού
// Τα κλειδιά είναι ελληνικά· η βάση είναι στο γλώσσα/Ελληνικά.zy.
//
// EN: γλώσσα/हिन्दी.zy — the हिन्दी locale (hi).
// The keys are Greek; the base lives in γλώσσα/Ελληνικά.zy.
// ============================================================

# .γλώσσα_हिन्दी {

    #> { κείμενο, φράση_πληθυσμού, φράση_τέλους, φράση_κόσμου, φράση_ρυθμού }

    κείμενο(κλειδί) {
        <~ ?? κλειδί {
            "γλώσσα.όνομα"            => "हिन्दी"
            "κατάσταση.γενιά"         => "पीढ़ी"
            "κατάσταση.πληθυσμός"     => "जीवित"
            "κατάσταση.κανόνας"       => "नियम"
            "κατάσταση.ρυθμός"        => "गति"
            "κατάσταση.σχήμα"         => "आकृति"
            "κατάσταση.τίποτα"        => "—"
            "τρόπος.σύνταξη"          => "संपादन"
            "τρόπος.εκτέλεση"         => "चालू "
            "τρόπος.τέλος"            => "समाप्त"
            "πλήκτρο.κίνηση"          => "चलाएँ"
            "πλήκτρο.εναλλαγή"        => "बदलें"
            "πλήκτρο.εκκίνηση"        => "चालू/बंद"
            "πλήκτρο.βήμα"            => "कदम"
            "πλήκτρο.καθάρισμα"       => "साफ़"
            "πλήκτρο.τυχαίο"          => "यादृच्छिक"
            "πλήκτρο.σχήμα"           => "आकृति"
            "πλήκτρο.θέμα"            => "रूप"
            "πλήκτρο.ταχύτητα"        => "गति"
            "πλήκτρο.γλώσσα"          => "भाषा"
            "πλήκτρο.έξοδος"          => "बाहर"
            "πλήκτρο.επιλογή"         => "चुनें"
            "πλήκτρο.άκυρο"           => "रद्द"
            "τέλος.εξαφάνιση"         => "सब मर गए"
            "τέλος.ακίνητο"           => "संसार जम गया"
            "τέλος.ταλάντωση"         => "संसार दोलन कर रहा है"
            "τέλος.όριο"              => "चालों की सीमा"
            "τέλος.χρήστης"           => "आपने रोका"
            "μενού.σχήματα"           => "आकृति चुनें"
            "μενού.γλώσσες"           => "भाषा चुनें"
            "κατηγορία.ακίνητο"       => "स्थिर"
            "κατηγορία.ταλαντωτής"    => "दोलक"
            "κατηγορία.διαστημόπλοιο" => "अंतरिक्षयान"
            "κατηγορία.μαθουσάλας"    => "दीर्घजीवी"
            "κατηγορία.κανόνι"        => "तोप"
            "σχήμα.block"             => "खंड"
            "σχήμα.beehive"           => "मधुमक्खी का छत्ता"
            "σχήμα.loaf"              => "रोटी"
            "σχήμα.boat"              => "नाव"
            "σχήμα.tub"               => "कुंड"
            "σχήμα.blinker"           => "टिमटिमाता"
            "σχήμα.toad"              => "मेंढक"
            "σχήμα.beacon"            => "प्रकाशस्तंभ"
            "σχήμα.pulsar"            => "स्पंदक"
            "σχήμα.pentadecathlon"    => "पंचदशांग"
            "σχήμα.glider"            => "ग्लाइडर"
            "σχήμα.lwss"              => "हल्का यान"
            "σχήμα.mwss"              => "मध्यम यान"
            "σχήμα.hwss"              => "भारी यान"
            "σχήμα.rpentomino"        => "आर-पेंटोमिनो"
            "σχήμα.diehard"           => "अड़ियल"
            "σχήμα.acorn"             => "बलूत"
            "σχήμα.gosper"            => "गॉस्पर तोप"
            "θέμα.emoji"              => "इमोजी"
            "θέμα.block"              => "खंड"
            "θέμα.ascii"              => "अक्षर"
            "σφάλμα.κανόνας_μορφή"    => "नियम B<अंक>/S<अंक> लिखा जाता है, जैसे B3/S23"
            "σφάλμα.κανόνας_κενό"     => "नियम का एक भाग खाली है"
            "σφάλμα.κανόνας_γράμμα"   => "नियम का हर भाग B या S से शुरू होता है"
            "σφάλμα.κανόνας_ψηφίο"    => "पड़ोसियों की संख्या 0 से 8 तक का अंक है"
            "σφάλμα.άγνωστο_σχήμα"    => "ऐसी कोई आकृति नहीं है"
            "σφάλμα.άγνωστο_θέμα"     => "ऐसा कोई रूप नहीं है"
            "σφάλμα.άγνωστη_γλώσσα"   => "ऐसी कोई भाषा नहीं है"
            "σφάλμα.άγνωστη_επιλογή"  => "अज्ञात विकल्प"
            "σφάλμα.λείπει_τιμή"      => "इस विकल्प को एक मान चाहिए"
            "σφάλμα.αριθμός"          => "यहाँ एक अऋणात्मक पूर्णांक चाहिए"
            "σφάλμα.μικρή_οθόνη"      => "स्क्रीन बहुत छोटी है"
            "χρήση.τίτλος"            => "कॉनवे का जीवन का खेल"
            "χρήση.γραμμές"           => "संसार की ऊँचाई"
            "χρήση.στήλες"            => "संसार की चौड़ाई"
            "χρήση.σχήμα"             => "किसी ज्ञात आकृति से शुरू करें, बीच में"
            "χρήση.κανόνας"           => "B3/S23 (मूल), B36/S23, B2/S, ..."
            "χρήση.θέμα"              => "इमोजी (मूल), खंड, अक्षर"
            "χρήση.ρυθμός"            => "प्रति पीढ़ी मिलीसेकंड"
            "χρήση.σπόρος"            => "यादृच्छिक का बीज"
            "χρήση.τυχαίο"            => "संसार को यादृच्छिक भरें"
            "χρήση.φραγμένο"          => "संसार की सीमाएँ हैं (अन्यथा वह टोरस है)"
            "χρήση.τρέξε"             => "संपादन के बजाय चलते हुए शुरू करें"
            "χρήση.γύροι"             => "N पीढ़ियों के बाद रुकें"
            "χρήση.γενιές"            => "बिना स्क्रीन के चलाएँ और परिणाम बताएँ"
            "χρήση.κάθε"              => "--batch के साथ, हर K पीढ़ी बताएँ"
            "χρήση.τύπωσε"            => "--batch के साथ, अंतिम संसार छापें"
            "χρήση.χρόνος"            => "--batch के साथ, अवधि ms में बताएँ"
            "χρήση.γλώσσα"            => "el (मूल), es, en, hi"
            "χρήση.κατάλογος"         => "आकृतियाँ और रूप दिखाएँ"
            "χρήση.βοήθεια"           => "यह पाठ"
            "χρήση.σχήματα"           => "आकृतियाँ"
            "χρήση.περιορίστηκε"      => "संसार स्क्रीन के अनुसार सीमित किया गया"

            _                         => κλειδί
        }
    }

    // Los dígitos salen en devanagari sin que este archivo haga nada:
    // el modo numeral lo fijó el diανομέας al elegir la lengua.
    // EN: the digits come out in Devanagari without this file doing
    // anything — the dispatcher set the numeral mode when the
    // language was chosen (USERAPPI18N.md §14).
    φράση_πληθυσμού(ν) {
        ? ν == 1 { <~ "{ν} कोशिका जीवित" }
        <~ "{ν} कोशिकाएँ जीवित"
    }

    φράση_τέλους(αιτία, γενιά, περίοδος) {
        ?? αιτία {
            "εξαφάνιση" => { <~ "पीढ़ी {γενιά} में सब मर गए" }
            "ακίνητο"   => { <~ "पीढ़ी {γενιά} में संसार जम गया" }
            "ταλάντωση" => { <~ "संसार {περίοδος} की अवधि से दोलन कर रहा है, पीढ़ी {γενιά} से" }
            "όριο"      => { <~ "पीढ़ी {γενιά} पर रुका" }
            _           => { <~ "आपने पीढ़ी {γενιά} पर रोका" }
        }
    }

    φράση_κόσμου(γραμμές, στήλες, τοροειδές) {
        ? τοροειδές { <~ "{γραμμές}×{στήλες} टोरस" }
        <~ "{γραμμές}×{στήλες} सीमित" }

    φράση_ρυθμού(χιλιοστά) { <~ "{χιλιοστά} ms" }
}
