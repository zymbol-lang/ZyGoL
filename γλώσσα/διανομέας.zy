// ============================================================
// γλώσσα/διανομέας.zy — ο διανομέας των λέξεων.
//
// Κάθε κείμενο που φτάνει στα μάτια του χρήστη περνά από εδώ, και
// από πουθενά αλλού. Η ενεργή γλώσσα κρατιέται ως κατάσταση του
// module — η Zymbol τη μοιράζεται ανά διαδρομή αρχείου, οπότε κάθε
// module που εισάγει αυτό βλέπει την ίδια επιλογή χωρίς να περνάει
// κανείς παράμετρο γλώσσας από κλήση σε κλήση (USERAPPI18N.md §2).
//
// Τα κλειδιά είναι ελληνικά. Η βάση είναι ελληνικά και κάθε άλλη
// γλώσσα κάθεται από πάνω: όταν το παιχνίδι ζητά "τέλος.ακίνητο"
// ζητά μια ελληνική έννοια, όχι ένα αγγλικό αναγνωριστικό. Κάθε
// module γλώσσας είναι ένας πίνακας που γράφει την έννοια στα δικά
// του λόγια, και ο ελληνικός πίνακας είναι η βάση που την ξεδιπλώνει
// σε ελληνική φράση.
//
// Κάθε κλειδί έχει πρόθεμα περιοχής ("τέλος.ακίνητο", ποτέ σκέτο
// "ακίνητο"), ώστε ένα κλειδί να μην μπορεί ποτέ να ισούται με τη
// μετάφρασή του. Αυτό κρατά αποφασίσιμο τον έλεγχο «μετάφραση ίση με
// κλειδί σημαίνει λείπει» και στα ελληνικά (USERAPPI18N.md §3).
//
// Το να προστεθεί γλώσσα είναι τρεις αλλαγές: ένα αρχείο
// γλώσσα/<Όνομα>.zy που τηρεί το συμβόλαιο των έξι συναρτήσεων, μία
// εισαγωγή εδώ, κι ένα κλαδί σε κάθε διανομή. Το
// δοκιμές/γλώσσα.zy το ελέγχει μετά κλειδί προς κλειδί.
//
// EN: γλώσσα/διανομέας.zy — the i18n dispatcher. Locale is module
// state, never a parameter. Keys are Greek, the language the program
// is written in. Adding a locale is three edits.
// ============================================================

# .γλώσσα_διανομέας {

    <# ./Ελληνικά => ελ
    <# ./Español => ισ
    <# ./English => αγ
    <# ./हिन्दी => ιν

    #> {
        όρισε
        τρέχουσα
        γλώσσες
        κλειδιά
        κείμενο
        όνομα_γλώσσας
        φράση_πληθυσμού
        φράση_τέλους
        φράση_κόσμου
        φράση_ρυθμού
    }

    τρέχουσα_γλώσσα = "el"

    // Κωδικοί ISO 639-1, στη σειρά που εμφανίζονται στο μενού. Οι
    // κωδικοί είναι διεθνής σύμβαση και δεν μεταφράζονται. Τα
    // ελληνικά είναι πρώτα επειδή το πρόγραμμα είναι γραμμένο στα
    // ελληνικά· μετά ισπανικά και αγγλικά, και τελευταία τα χίντι,
    // που είναι η μόνη γλώσσα εδώ με δικά της ψηφία.
    γλώσσες() { <~ ["el", "es", "en", "hi"] }

    τρέχουσα() { <~ τρέχουσα_γλώσσα }

    // Η γλώσσα διαλέγει και τη ΓΡΑΦΗ ΤΩΝ ΨΗΦΙΩΝ. Ο διακόπτης είναι
    // καθολικός στη διεργασία, οπότε μπαίνει εδώ μία φορά και κανένα
    // σημείο κλήσης δεν χρειάζεται να ξέρει: ο ίδιος κώδικας τυπώνει
    // 42 ή ४२ ανάλογα με τη γλώσσα (USERAPPI18N.md §14).
    όρισε(κωδικός) {
        τρέχουσα_γλώσσα = κωδικός
        ?? κωδικός {
            "hi" => { #०९# }
            _    => { #09# }
        }
        <~ 0
    }

    κείμενο(κλειδί) {
        ?? τρέχουσα_γλώσσα {
            "es" => { <~ ισ::κείμενο(κλειδί) }
            "en" => { <~ αγ::κείμενο(κλειδί) }
            "hi" => { <~ ιν::κείμενο(κλειδί) }
            _    => { <~ ελ::κείμενο(κλειδί) }
        }
    }

    // Το όνομα ΜΙΑΣ γλώσσας, γραμμένο στην ίδια. «Español» γράφεται
    // Español είτε το πρόγραμμα τρέχει στα ελληνικά είτε στα χίντι:
    // ένα μενού γλωσσών είναι το ένα μενού που δεν επιτρέπεται να
    // χρειάζεται μετάφραση (USERAPPI18N.md §7).
    όνομα_γλώσσας(κωδικός) {
        ?? κωδικός {
            "es" => { <~ ισ::κείμενο("γλώσσα.όνομα") }
            "en" => { <~ αγ::κείμενο("γλώσσα.όνομα") }
            "hi" => { <~ ιν::κείμενο("γλώσσα.όνομα") }
            _    => { <~ ελ::κείμενο("γλώσσα.όνομα") }
        }
    }

    φράση_πληθυσμού(ν) {
        ?? τρέχουσα_γλώσσα {
            "es" => { <~ ισ::φράση_πληθυσμού(ν) }
            "en" => { <~ αγ::φράση_πληθυσμού(ν) }
            "hi" => { <~ ιν::φράση_πληθυσμού(ν) }
            _    => { <~ ελ::φράση_πληθυσμού(ν) }
        }
    }

    φράση_τέλους(αιτία, γενιά, περίοδος) {
        ?? τρέχουσα_γλώσσα {
            "es" => { <~ ισ::φράση_τέλους(αιτία, γενιά, περίοδος) }
            "en" => { <~ αγ::φράση_τέλους(αιτία, γενιά, περίοδος) }
            "hi" => { <~ ιν::φράση_τέλους(αιτία, γενιά, περίοδος) }
            _    => { <~ ελ::φράση_τέλους(αιτία, γενιά, περίοδος) }
        }
    }

    φράση_κόσμου(γραμμές, στήλες, τοροειδές) {
        ?? τρέχουσα_γλώσσα {
            "es" => { <~ ισ::φράση_κόσμου(γραμμές, στήλες, τοροειδές) }
            "en" => { <~ αγ::φράση_κόσμου(γραμμές, στήλες, τοροειδές) }
            "hi" => { <~ ιν::φράση_κόσμου(γραμμές, στήλες, τοροειδές) }
            _    => { <~ ελ::φράση_κόσμου(γραμμές, στήλες, τοροειδές) }
        }
    }

    φράση_ρυθμού(χιλιοστά) {
        ?? τρέχουσα_γλώσσα {
            "es" => { <~ ισ::φράση_ρυθμού(χιλιοστά) }
            "en" => { <~ αγ::φράση_ρυθμού(χιλιοστά) }
            "hi" => { <~ ιν::φράση_ρυθμού(χιλιοστά) }
            _    => { <~ ελ::φράση_ρυθμού(χιλιοστά) }
        }
    }

    // Ο κύριος κατάλογος κλειδιών. Αυτό είναι το συμβόλαιο που κάθε
    // γλώσσα οφείλει να τηρήσει, και η είσοδος του ελέγχου: το
    // δοκιμές/γλώσσα.zy το περπατά σε κάθε γλώσσα και αναφέρει κάθε
    // κλειδί που έπεσε στην ταυτοτική περίπτωση.
    κλειδιά() {
        <~ [
            "γλώσσα.όνομα",

            "κατάσταση.γενιά", "κατάσταση.πληθυσμός", "κατάσταση.κανόνας",
            "κατάσταση.ρυθμός", "κατάσταση.σχήμα", "κατάσταση.τίποτα",

            "τρόπος.σύνταξη", "τρόπος.εκτέλεση", "τρόπος.τέλος",

            "πλήκτρο.κίνηση", "πλήκτρο.εναλλαγή", "πλήκτρο.εκκίνηση",
            "πλήκτρο.βήμα", "πλήκτρο.καθάρισμα", "πλήκτρο.τυχαίο",
            "πλήκτρο.σχήμα", "πλήκτρο.θέμα", "πλήκτρο.ταχύτητα",
            "πλήκτρο.γλώσσα", "πλήκτρο.έξοδος", "πλήκτρο.επιλογή",
            "πλήκτρο.άκυρο",

            "τέλος.εξαφάνιση", "τέλος.ακίνητο", "τέλος.ταλάντωση",
            "τέλος.όριο", "τέλος.χρήστης",

            "μενού.σχήματα", "μενού.γλώσσες",

            "κατηγορία.ακίνητο", "κατηγορία.ταλαντωτής",
            "κατηγορία.διαστημόπλοιο", "κατηγορία.μαθουσάλας",
            "κατηγορία.κανόνι",

            "σχήμα.block", "σχήμα.beehive", "σχήμα.loaf", "σχήμα.boat",
            "σχήμα.tub", "σχήμα.blinker", "σχήμα.toad", "σχήμα.beacon",
            "σχήμα.pulsar", "σχήμα.pentadecathlon", "σχήμα.glider",
            "σχήμα.lwss", "σχήμα.mwss", "σχήμα.hwss", "σχήμα.rpentomino",
            "σχήμα.diehard", "σχήμα.acorn", "σχήμα.gosper",

            "θέμα.emoji", "θέμα.block", "θέμα.ascii",

            "σφάλμα.κανόνας_μορφή", "σφάλμα.κανόνας_κενό",
            "σφάλμα.κανόνας_γράμμα", "σφάλμα.κανόνας_ψηφίο",
            "σφάλμα.άγνωστο_σχήμα", "σφάλμα.άγνωστο_θέμα",
            "σφάλμα.άγνωστη_γλώσσα", "σφάλμα.άγνωστη_επιλογή",
            "σφάλμα.λείπει_τιμή", "σφάλμα.αριθμός", "σφάλμα.μικρή_οθόνη",

            "χρήση.τίτλος", "χρήση.γραμμές", "χρήση.στήλες", "χρήση.σχήμα",
            "χρήση.κανόνας", "χρήση.θέμα", "χρήση.ρυθμός", "χρήση.σπόρος",
            "χρήση.τυχαίο", "χρήση.φραγμένο", "χρήση.τρέξε", "χρήση.γύροι",
            "χρήση.γενιές", "χρήση.κάθε", "χρήση.τύπωσε", "χρήση.γλώσσα",
            "χρήση.χρόνος", "χρήση.κατάλογος", "χρήση.βοήθεια", "χρήση.σχήματα",
            "χρήση.περιορίστηκε"
        ]
    }
}
